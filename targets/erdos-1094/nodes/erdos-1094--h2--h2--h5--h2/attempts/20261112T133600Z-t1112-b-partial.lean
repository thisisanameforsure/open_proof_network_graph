                        ∏ p ∈ Finset.Icc (1 : ℕ) k with Nat.Prime p, p ^ (m.factorization : ℕ → ℕ) p =
                      k.factorial →
                    k ≤ K := by
  -- approach: each window integer m = s·r with s its k-smooth part and every prime of r above n/k (sieve-free), so r = 1 or r > n/k, hence m is k-smooth or s < k: k smooth parts each below k multiplying to k!. The core is that case.
