            (∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ (m.factorization p)) < k := by
        sorry
      exact h_split
    ·
      -- label: window smooth parts below k or whole, multiplying to k!
      -- claim: $\forall c>0\ \exists K\ \forall n,k:\ 0<k,\ k^3\le n,\ \exp(c\log^2 k)<n,\ \operatorname{lpf}\binom nk>\lfloor n/k\rfloor,\ \bigl(\forall p \text{ prime},\ k<p\le\lfloor n/k\rfloor,\ \forall m\in(n-k,n],\ p\nmid m\bigr),\ \prod_{m=n-k+1}^{n} s_k(m) = k!,\ \bigl(\forall m\in(n-k,n]:\ s_k(m)=m \text{ or } s_k(m)<k\bigr) \Rightarrow k\le K$
      -- Here $s_k(m) = \prod_{p \le k \text{ prime}} p^{v_p(m)}$ is the $k$-smooth part of $m$. The open core with the window's arithmetic shape in hand.
      have h_core : ∃ K : ℕ, ∀ n k : ℕ, 0 < k → k * k * k ≤ n →
          Real.exp (c * Real.log (k : ℝ) ^ (2 : ℕ)) < (n : ℝ) → (n.choose k).minFac > n / k →
          (∀ p : ℕ, p.Prime → k < p → p ≤ n / k → ∀ m : ℕ, n - k < m → m ≤ n → ¬ p ∣ m) →
