  intro c hc
  have hall : (∀ n k : ℕ, 0 < k → k ≤ n →
        (∀ p : ℕ, p.Prime → k < p → p ≤ n / k → ∀ m : ℕ, n - k < m → m ≤ n → ¬ p ∣ m) →
        ∀ m : ℕ, n - k < m → m ≤ n →
          (∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ (m.factorization p)) = m ∨
          (∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ (m.factorization p)) < k) ∧
      (∃ K : ℕ, ∀ n k : ℕ, 0 < k → k * k * k ≤ n →
        Real.exp (c * Real.log (k : ℝ) ^ (2 : ℕ)) < (n : ℝ) → (n.choose k).minFac > n / k →
        (∀ p : ℕ, p.Prime → k < p → p ≤ n / k → ∀ m : ℕ, n - k < m → m ≤ n → ¬ p ∣ m) →
        (∏ m ∈ Finset.Ioc (n - k) n, ∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ (m.factorization p)) = k.factorial →
        (∀ m : ℕ, n - k < m → m ≤ n →
          (∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ (m.factorization p)) = m ∨
          (∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ (m.factorization p)) < k) →
        k ≤ K) := by
    refine ⟨?_, ?_⟩
    ·
      -- label: window integers are k-smooth or have k-smooth part below k
      -- claim: $\forall n,k:\ 0<k\le n,\ \bigl(\forall p \text{ prime},\ k<p\le\lfloor n/k\rfloor,\ \forall m\in(n-k,n],\ p\nmid m\bigr) \Rightarrow \forall m\in(n-k,n]:\ s_k(m)=m\ \text{ or }\ s_k(m)<k$
      -- Here $s_k(m) = \prod_{p \le k \text{ prime}} p^{v_p(m)}$ is the $k$-smooth part of $m$, with $v_p(m)$ the exponent of $p$ in $m$ (`Nat.factorization m p`).
      have h_split : ∀ n k : ℕ, 0 < k → k ≤ n →
          (∀ p : ℕ, p.Prime → k < p → p ≤ n / k → ∀ m : ℕ, n - k < m → m ≤ n → ¬ p ∣ m) →
