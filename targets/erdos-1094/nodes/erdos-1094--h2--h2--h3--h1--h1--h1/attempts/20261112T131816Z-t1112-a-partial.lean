theorem erdos_1094__h2__h2__h3__h1__h1__h1 : ∃ (K : ℕ),
  ∀ (n k : ℕ),
    (0 : ℕ) < k →
      k * k * k ≤ n →
        Real.exp (Real.log (↑k : ℝ) ^ (2 : ℕ) / ((20 : ℝ) * Real.log (Real.log (↑k : ℝ)))) < (↑n : ℝ) + (1 : ℝ) →
          k * (n / k) ∣ k.factorial →
            (∀ (p : ℕ), Nat.Prime p → p ≤ k → ¬p ∣ n.choose k) →
              (∀ (p : ℕ), Nat.Prime p → k < p → p ≤ n / k → k ≤ n % p) → Nat.Prime (n / n.gcd k) → ¬k ∣ n → k ≤ K := by
  -- approach: Kummer's digit form at primes p ≤ k: p ∤ C(n,k) means adding k and n−k in base p carries nowhere, i.e. k mod p^i ≤ n mod p^i for every i; proved here from Nat.Prime.emultiplicity_choose, and the one hole is the residue form with the digit conditions in place of p ∤ C(n,k).
  -- licence: CC-BY-4.0
  -- label: digit form beyond van Doorn–Tang
  -- claim: $\exists K\ \forall n,k:\ 0<k,\ k^3\le n,\ \exp\bigl(\log^2 k/(20\log\log k)\bigr)<n+1,\ k\lfloor n/k\rfloor\mid k!,\ (\forall p\le k\text{ prime},\ \forall i:\ k\bmod p^i\le n\bmod p^i),\ (\forall p\text{ prime},\ k<p\le\lfloor n/k\rfloor:\ k\le n\bmod p),\ n/\gcd(n,k)\text{ prime},\ k\nmid n\ \Rightarrow\ k\le K$
  -- The residue form with, at every prime p ≤ k, each base-p digit of k at most the corresponding digit of n (no carry adding k and n−k; equivalently the window n−k+1..n holds exactly ⌊k/p^i⌋ multiples of p^i for every i), and n mod p ≥ k at every prime k < p ≤ ⌊n/k⌋.
  have h_digits : ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → k * k * k ≤ n →
      Real.exp (Real.log (↑k : ℝ) ^ (2 : ℕ) / ((20 : ℝ) * Real.log (Real.log (↑k : ℝ)))) < (↑n : ℝ) + (1 : ℝ) →
      k * (n / k) ∣ k.factorial → (∀ p : ℕ, p.Prime → p ≤ k → ∀ i : ℕ, k % p ^ i ≤ n % p ^ i) →
      (∀ p : ℕ, p.Prime → k < p → p ≤ n / k → k ≤ n % p) → Nat.Prime (n / n.gcd k) → ¬k ∣ n → k ≤ K := sorry
  -- Kummer: a prime p not dividing C(n,k) carries nowhere, so each base-p digit of k is at most n's.
  have kummer : ∀ (n k p : ℕ), p.Prime → k ≤ n → ¬ p ∣ n.choose k → ∀ i : ℕ, k % p ^ i ≤ n % p ^ i := by
    intro n k p hp hkn hnd
    intro i
    have hb : Nat.log p n < Nat.log p n + 1 + i := by omega
    have hmul := Nat.Prime.emultiplicity_choose hp hkn hb
    have h0 : emultiplicity p (n.choose k) = 0 := by
      rw [emultiplicity_eq_zero]; exact hnd
    rw [h0] at hmul
    have hcard : ((Finset.Ico 1 (Nat.log p n + 1 + i)).filter
        fun j => p ^ j ≤ k % p ^ j + (n - k) % p ^ j).card = 0 := by
      exact_mod_cast hmul.symm
    rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff] at hcard
    rcases Nat.eq_zero_or_pos i with hi | hi
    · subst hi; simp [Nat.mod_one]
    have hmem : i ∈ Finset.Ico 1 (Nat.log p n + 1 + i) := Finset.mem_Ico.2 ⟨hi, by omega⟩
    have hlt : k % p ^ i + (n - k) % p ^ i < p ^ i := by
      have := hcard hmem; push_neg at this; exact this
    have hsum : n = k + (n - k) := by omega
    have hpos : 0 < p ^ i := pow_pos hp.pos i
    calc k % p ^ i ≤ k % p ^ i + (n - k) % p ^ i := Nat.le_add_right _ _
      _ = (k % p ^ i + (n - k) % p ^ i) % p ^ i := (Nat.mod_eq_of_lt hlt).symm
      _ = (k + (n - k)) % p ^ i := (Nat.add_mod _ _ _).symm
      _ = n % p ^ i := by rw [← hsum]
  obtain ⟨K, hK⟩ := h_digits
  refine ⟨K, fun n k hk hn hT hfac hsmall hbig hprime hndvd => hK n k hk hn hT hfac ?_ hbig hprime hndvd⟩
  intro p hp hpk
  have h2 : k ≤ n / k := (Nat.le_div_iff_mul_le hk).2 (le_trans (Nat.le_mul_of_pos_right _ hk) hn)
  have hkn : k ≤ n := le_trans h2 (Nat.div_le_self n k)
  exact kummer n k p hp hkn (hsmall p hp hpk)
