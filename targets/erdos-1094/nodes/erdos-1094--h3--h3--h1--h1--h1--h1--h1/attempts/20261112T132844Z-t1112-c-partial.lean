theorem erdos_1094__h3__h3__h1__h1__h1__h1__h1 : ∀ (f : ℕ → ℝ) (A : ℝ),
  (∀ (n : ℕ), (0 : ℝ) ≤ f n) →
    (∀ (ψ : ℝ → ℝ),
        ContDiff ℝ (2 : WithTop ℕ∞) ψ →
          HasCompactSupport ψ →
            Function.support ψ ⊆ Set.Ioi (0 : ℝ) →
              Filter.Tendsto (fun (X : ℝ) => (∑' (n : ℕ), f n * ψ ((↑n : ℝ) / X)) / X) Filter.atTop
                (nhds (A * ∫ (x : ℝ), ψ x))) →
      Filter.Tendsto (fun (N : ℕ) => (∑ n ∈ Finset.range N, f n) / (↑N : ℝ)) Filter.atTop (nhds A) := by
  -- approach: unsmoothing in two steps: one bump ψ ≥ 1 on [1/4, 1] bounds every dyadic block, so the partial sums are O(N); then bumps ψ₋ ≤ 1_{[δ,1]} ≤ ψ₊ with ∫ψ± within ε of 1 sandwich S(N)/N, the part n < δN costing at most Cδ.
  -- licence: CC-BY-4.0
  intro f A hf hsmooth
  -- label: partial sums are O(N)
  -- claim: $\exists C,\ \forall N,\ \sum_{n<N} f(n) \le C\,N$
  -- One C² bump with ψ ≥ 1 on [1/4, 1] and support in (0, 2) bounds each block Σ_{N/4<n≤N} f(n) by
  -- (A∫ψ + 1)N for large N; summing the blocks over N, N/4, N/16, … gives the linear bound.
  have h_bound : ∃ C : ℝ, ∀ N : ℕ, ∑ n ∈ Finset.range N, f n ≤ C * N := by
    sorry
  -- label: sandwich by bumps
  -- claim: $\bigl(\exists C,\ \forall N,\ \sum_{n<N} f(n) \le C N\bigr) \Rightarrow \tfrac{1}{N}\sum_{n<N} f(n) \to A$
  -- Given the linear bound, for ε > 0 take δ small and bumps ψ₋ ≤ 1_{[δ,1]} ≤ ψ₊ supported in (δ/2, 1+δ)
  -- with ∫ψ₊ − ∫ψ₋ ≤ ε; the smoothed limits for ψ± and the bound Σ_{n<δN} f(n) ≤ CδN give
  -- limsup and liminf of S(N)/N within O(ε + δ) of A.
  have h_sandwich : (∃ C : ℝ, ∀ N : ℕ, ∑ n ∈ Finset.range N, f n ≤ C * N) →
      Filter.Tendsto (fun (N : ℕ) => (∑ n ∈ Finset.range N, f n) / (↑N : ℝ)) Filter.atTop (nhds A) := by
    sorry
  exact h_sandwich h_bound
