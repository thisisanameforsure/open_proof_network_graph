theorem erdos_1094__h2__h2__h5 : ∀ (c : ℝ),
  (0 : ℝ) < c →
    ∃ (K : ℕ),
      ∀ (n k : ℕ),
        (0 : ℕ) < k →
          k * k * k ≤ n → Real.exp (c * Real.log (↑k : ℝ) ^ (2 : ℕ)) < (↑n : ℝ) → (n.choose k).minFac > n / k → k ≤ K := by
  -- approach: sieve step: a prime p in (k, n/k] with a multiple among n-k+1..n divides C(n,k), so those k integers carry no prime in (k, n/k]; and their k-smooth parts multiply to k! times the k-smooth part of C(n,k), which is 1 here. The core is the case with both facts in hand.
  -- licence: CC-BY-4.0
  intro c hc
  have hall : (∀ n k : ℕ, 0 < k → k ≤ n →
        (∏ m ∈ Finset.Ioc (n - k) n, ∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ (m.factorization p)) =
          k.factorial * ∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ ((n.choose k).factorization p)) ∧
      (∃ K : ℕ, ∀ n k : ℕ, 0 < k → k * k * k ≤ n →
        Real.exp (c * Real.log (k : ℝ) ^ (2 : ℕ)) < (n : ℝ) → (n.choose k).minFac > n / k →
        (∀ p : ℕ, p.Prime → k < p → p ≤ n / k → ∀ m : ℕ, n - k < m → m ≤ n → ¬ p ∣ m) →
        (∏ m ∈ Finset.Ioc (n - k) n, ∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ (m.factorization p)) = k.factorial →
        k ≤ K) := by
    refine ⟨?_, ?_⟩
    ·
      -- label: the k-smooth parts of n-k+1..n multiply to k! times C(n,k)'s
      -- claim: $\forall n,k:\ 0<k\le n \Rightarrow \prod_{m=n-k+1}^{n}\ \prod_{p\le k,\ p \text{ prime}} p^{v_p(m)} = k!\cdot\prod_{p\le k,\ p \text{ prime}} p^{v_p\binom nk}$
      -- Here $v_p(m)$ is the exponent of $p$ in $m$ (`Nat.factorization m p`); the products over primes $p \le k$ are the $k$-smooth parts of $m$ and of $\binom nk$.
      have h_prod : ∀ n k : ℕ, 0 < k → k ≤ n →
          (∏ m ∈ Finset.Ioc (n - k) n, ∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ (m.factorization p)) =
            k.factorial * ∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ ((n.choose k).factorization p) := by
        sorry
      exact h_prod
    ·
      -- label: n-k+1..n free of primes in (k, n/k], smooth parts k!
      -- claim: $\forall c>0\ \exists K\ \forall n,k:\ 0<k,\ k^3\le n,\ \exp(c\log^2 k)<n,\ \operatorname{lpf}\binom nk>\lfloor n/k\rfloor,\ \bigl(\forall p \text{ prime},\ k<p\le\lfloor n/k\rfloor,\ \forall m\in(n-k,n],\ p\nmid m\bigr),\ \prod_{m=n-k+1}^{n}\prod_{p\le k \text{ prime}} p^{v_p(m)} = k! \Rightarrow k\le K$
      -- The sieve-free case: no integer among n-k+1, ..., n has a prime factor in (k, n/k], and their k-smooth parts multiply to k!.
      have h_core : ∃ K : ℕ, ∀ n k : ℕ, 0 < k → k * k * k ≤ n →
          Real.exp (c * Real.log (k : ℝ) ^ (2 : ℕ)) < (n : ℝ) → (n.choose k).minFac > n / k →
          (∀ p : ℕ, p.Prime → k < p → p ≤ n / k → ∀ m : ℕ, n - k < m → m ≤ n → ¬ p ∣ m) →
          (∏ m ∈ Finset.Ioc (n - k) n, ∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ (m.factorization p)) = k.factorial →
          k ≤ K := by
        sorry
      exact h_core
  obtain ⟨h_prod, K, hK⟩ := hall
  refine ⟨K, ?_⟩
  intro n k hk h3 hexp hmin
  have hkn : k ≤ n := le_trans (Nat.le_mul_of_pos_left k (Nat.mul_pos hk hk)) h3
  have hkk : k ≤ n / k := (Nat.le_div_iff_mul_le hk).2 (le_trans (Nat.mul_le_mul_left k (Nat.le_mul_of_pos_left k hk)) (by simpa [mul_comm, mul_left_comm, mul_assoc] using h3))
  -- no prime ≤ k divides C(n,k), so its k-smooth part is 1 and the identity reads: the smooth parts multiply to k!
  have hnd : ∀ p ∈ (Finset.Icc 1 k).filter Nat.Prime, ¬ p ∣ n.choose k := by
    intro p hpS hpd
    have hp : p.Prime := (Finset.mem_filter.mp hpS).2
    have hpk : p ≤ k := (Finset.mem_Icc.mp (Finset.mem_filter.mp hpS).1).2
    have := Nat.minFac_le_of_dvd hp.two_le hpd
    omega
  have hsmooth : (∏ m ∈ Finset.Ioc (n - k) n, ∏ p ∈ (Finset.Icc 1 k).filter Nat.Prime, p ^ (m.factorization p)) = k.factorial := by
    rw [h_prod n k hk hkn, Finset.prod_eq_one (fun p hp => by rw [Nat.factorization_eq_zero_of_not_dvd (hnd p hp), pow_zero]), mul_one]
  refine hK n k hk h3 hexp hmin ?_ hsmooth
  intro p hp hkp hpn m hm1 hm2 hpm
  -- p divides the falling product n (n-1) ... (n-k+1) = k! * C(n,k), and p > k, so p divides C(n,k)
  have hmem : n - m ∈ Finset.range k := Finset.mem_range.mpr (by omega)
  have h2 : (n - (n - m)) ∣ n.descFactorial k := by
    rw [Nat.descFactorial_eq_prod_range]
    exact Finset.dvd_prod_of_mem (fun i => n - i) hmem
  rw [Nat.sub_sub_self hm2] at h2
  have hdesc : p ∣ n.descFactorial k := hpm.trans h2
  have hfac : ¬ p ∣ k.factorial := fun h => absurd (hp.dvd_factorial.mp h) (Nat.not_le.mpr hkp)
  rw [Nat.descFactorial_eq_factorial_mul_choose] at hdesc
  have hchoose : p ∣ n.choose k := (hp.dvd_mul.mp hdesc).resolve_left hfac
  have hle : (n.choose k).minFac ≤ p := Nat.minFac_le_of_dvd hp.two_le hchoose
  exact absurd (lt_of_lt_of_le hmin (hle.trans hpn)) (lt_irrefl _)
