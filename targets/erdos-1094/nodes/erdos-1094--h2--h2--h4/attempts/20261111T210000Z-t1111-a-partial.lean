/-! Hole `h_kfull` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

private lemma KF_carry (n k p q : ℕ) (hp : p.Prime) (hq : 2 ≤ q) (hk1 : q * p ≤ k + p) (hk2 : k < q * p) :
    p ∣ n.choose k ∨
      ∃ a : ℤ, |(n : ℝ) / ((q * p : ℕ) : ℝ) - (a : ℝ) / (q : ℝ)| ≤
        (((q * p : ℕ) : ℝ) - (k : ℝ)) / ((q * p : ℕ) : ℝ) := by
  have hp0 : 0 < p := hp.pos
  by_cases hlt : n % p < k % p
  · left
    have hfact : Fact p.Prime := ⟨hp⟩
    have hzero : (n % p).choose (k % p) = 0 := Nat.choose_eq_zero_of_lt hlt
    have hmodeq := Choose.choose_modEq_choose_mod_mul_choose_div_nat (n := n) (k := k) (p := p)
    rw [hzero, zero_mul] at hmodeq
    exact (Nat.modEq_zero_iff_dvd).1 hmodeq
  · right
    -- k = (q - 1) * p + (k % p)
    obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
    have hqp : (q' + 1) * p = q' * p + p := by ring
    have hk1' : q' * p ≤ k := by omega
    have hk2' : k < q' * p + p := by omega
    have hkmod : k % p = k - q' * p := by
      have h1 : k = (k - q' * p) + q' * p := by omega
      have h2 : k - q' * p < p := by omega
      conv_lhs => rw [h1]
      rw [Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt h2]
    have hr : n % p < p := Nat.mod_lt _ hp0
    have hdiv : p * (n / p) + n % p = n := Nat.div_add_mod n p
    generalize n / p = d at hdiv
    refine ⟨(d : ℤ) + 1, ?_⟩
    have hpR : (0 : ℝ) < (p : ℝ) := by exact_mod_cast hp0
    have hqR : (0 : ℝ) < ((q' + 1 : ℕ) : ℝ) := by positivity
    have hmR : (0 : ℝ) < (((q' + 1) * p : ℕ) : ℝ) := by positivity
    have hnR : (n : ℝ) = (p : ℝ) * (d : ℝ) + ((n % p : ℕ) : ℝ) := by exact_mod_cast hdiv.symm
    have hge : (k : ℝ) - ((q' * p : ℕ) : ℝ) ≤ ((n % p : ℕ) : ℝ) := by
      have h3 : k - q' * p ≤ n % p := by omega
      have h4 : ((k - q' * p : ℕ) : ℝ) ≤ ((n % p : ℕ) : ℝ) := by exact_mod_cast h3
      rw [Nat.cast_sub hk1'] at h4
      exact h4
    have hltR : ((n % p : ℕ) : ℝ) < (p : ℝ) := by exact_mod_cast hr
    have key : (n : ℝ) / (((q' + 1) * p : ℕ) : ℝ) - (((d : ℤ) + 1 : ℤ) : ℝ) / ((q' + 1 : ℕ) : ℝ)
        = -(((p : ℝ) - ((n % p : ℕ) : ℝ)) / (((q' + 1) * p : ℕ) : ℝ)) := by
      rw [hnR]; push_cast; field_simp; ring
    rw [key, abs_neg, abs_of_nonneg (div_nonneg (by linarith) hmR.le)]
    apply div_le_div_of_nonneg_right _ hmR.le
    push_cast at hge ⊢
    nlinarith

private lemma KF_range (k q p : ℕ) (hk : 1 ≤ k) (hq : 2 ≤ q)
    (hqW : (q : ℝ) ≤ (k : ℝ) ^ (1 / 100 : ℝ)) (hkm : k < q * p)
    (hmH : ((q * p : ℕ) : ℝ) ≤ (k : ℝ) + (k : ℝ) ^ (3 / 5 : ℝ)) :
    q * p ≤ k + p := by
  have hk1 : (1 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hk0 : (0 : ℝ) < (k : ℝ) := by linarith
  have hH0 : (0 : ℝ) < (k : ℝ) ^ (3 / 5 : ℝ) := Real.rpow_pos_of_pos hk0 _
  have hprod : (k : ℝ) ^ (1 / 100 : ℝ) * (k : ℝ) ^ (3 / 5 : ℝ) ≤ (k : ℝ) := by
    rw [← Real.rpow_add hk0]
    calc (k : ℝ) ^ ((1 / 100 : ℝ) + (3 / 5 : ℝ)) ≤ (k : ℝ) ^ (1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le hk1 (by norm_num)
      _ = (k : ℝ) := Real.rpow_one _
  have hq0 : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
  have hkmR : (k : ℝ) < (q : ℝ) * (p : ℝ) := by exact_mod_cast hkm
  have hHp : (k : ℝ) ^ (3 / 5 : ℝ) < (p : ℝ) := by
    have h1 : (q : ℝ) * (k : ℝ) ^ (3 / 5 : ℝ) ≤ (k : ℝ) :=
      le_trans (mul_le_mul_of_nonneg_right hqW hH0.le) hprod
    have h2 : (q : ℝ) * (k : ℝ) ^ (3 / 5 : ℝ) < (q : ℝ) * (p : ℝ) := lt_of_le_of_lt h1 hkmR
    exact lt_of_mul_lt_mul_left h2 hq0.le
  have h3 : ((q * p : ℕ) : ℝ) < ((k + p : ℕ) : ℝ) := by push_cast; push_cast at hmH; linarith
  have h4 : q * p < k + p := by exact_mod_cast h3
  omega

private lemma KF_final
    (h_bhp : ∃ (C : ℝ),
        (0 : ℝ) < C ∧
          ∃ (k₀ : ℕ),
            ∀ (k : ℕ),
              k₀ ≤ k →
                C * (↑k : ℝ) ^ (21 / 40 : ℝ) / Real.log (↑k : ℝ) ≤
                  (↑{p ∈ Finset.Ioo ⌊(↑k : ℝ)⌋ ⌈(↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)⌉ |
                          (0 : ℤ) < p ∧
                            Nat.Prime p.natAbs ∧ (↑k : ℝ) < (↑p : ℝ) ∧ (↑p : ℝ) < (↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)}.card :
                    ℝ))
    (h_supply : (¬∃ (C : ℝ),
        (0 : ℝ) < C ∧
          ∃ (k₀ : ℕ),
            ∀ (k : ℕ),
              k₀ ≤ k →
                C * (↑k : ℝ) ^ (21 / 40 : ℝ) / Real.log (↑k : ℝ) ≤
                  (↑{p ∈ Finset.Ioo ⌊(↑k : ℝ)⌋ ⌈(↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)⌉ |
                          (0 : ℤ) < p ∧
                            Nat.Prime p.natAbs ∧ (↑k : ℝ) < (↑p : ℝ) ∧ (↑p : ℝ) < (↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)}.card :
                    ℝ)) ∨
        ∃ (c₁ : ℝ),
          (0 : ℝ) < c₁ ∧
            ∃ (k₀ : ℕ),
              ∀ (k : ℕ),
                k₀ ≤ k →
                  ∃ (S : Finset ℕ),
                    (∀ m ∈ S,
                        k < m ∧
                          (↑m : ℝ) ≤ (↑k : ℝ) + (↑k : ℝ) ^ (3 / 5 : ℝ) ∧
                            ∃ (q : ℕ) (p : ℕ),
                              (2 : ℕ) ≤ q ∧ (↑q : ℝ) ≤ (↑k : ℝ) ^ (1 / 100 : ℝ) ∧ Nat.Prime p ∧ m = q * p) ∧
                      c₁ * (↑k : ℝ) ^ (3 / 5 : ℝ) ≤ (↑S.card : ℝ))
    (h_count : ∀ (η : ℝ),
        (0 : ℝ) < η →
          ∃ (c : ℝ),
            (0 : ℝ) < c ∧
              ∃ (k₀ : ℕ),
                ∀ (k : ℕ),
                  k₀ ≤ k →
                    ∀ (n : ℕ),
                      k * k * k ≤ n →
                        (↑n : ℝ) ≤ Real.exp (c * Real.log (↑k : ℝ) ^ (2 : ℕ)) →
                          ∀ (S : Finset ℕ),
                            (∀ m ∈ S,
                                k < m ∧
                                  (↑m : ℝ) ≤ (↑k : ℝ) + (↑k : ℝ) ^ (3 / 5 : ℝ) ∧
                                    ∃ (a : ℤ) (q : ℕ),
                                      (0 : ℕ) < q ∧
                                        (↑q : ℝ) ≤ (↑k : ℝ) ^ (1 / 100 : ℝ) ∧
                                          |(↑n : ℝ) / (↑m : ℝ) - (↑a : ℝ) / (↑q : ℝ)| <
                                            (↑k : ℝ) ^ (3 / 5 : ℝ) / (↑k : ℝ)) →
                              (↑S.card : ℝ) < η * (↑k : ℝ) ^ (3 / 5 : ℝ)) :
    ∃ (c : ℝ),
        (0 : ℝ) < c ∧
          ∃ (k₀ : ℕ),
            ∀ (k : ℕ),
              k₀ ≤ k →
                ∀ (n : ℕ),
                  k * k * k ≤ n →
                    (↑n : ℝ) ≤ Real.exp (c * Real.log (↑k : ℝ) ^ (2 : ℕ)) →
                      ∃ (p : ℕ), Nat.Prime p ∧ p ≤ k ∧ p ∣ n.choose k := by
  obtain ⟨c₁, hc₁, ks, hs⟩ := h_supply.resolve_left (not_not.mpr h_bhp)
  obtain ⟨c, hc, kc, hcount⟩ := h_count c₁ hc₁
  refine ⟨c, hc, ks + kc + 1, fun k hk n hn hle => ?_⟩
  obtain ⟨S, hS, hcard⟩ := hs k (by omega)
  by_contra hno
  have hk1 : 1 ≤ k := by omega
  have hk0 : (0 : ℝ) < (k : ℝ) := by exact_mod_cast hk1
  have hH0 : (0 : ℝ) < (k : ℝ) ^ (3 / 5 : ℝ) := Real.rpow_pos_of_pos hk0 _
  have hlt := hcount k (by omega) n hn hle S (fun m hm => by
    obtain ⟨hkm, hmH, q, p, hq, hqW, hp, rfl⟩ := hS m hm
    refine ⟨hkm, hmH, ?_⟩
    have hr := KF_range k q p hk1 hq hqW hkm hmH
    rcases KF_carry n k p q hp hq hr hkm with hd | ⟨a, ha⟩
    · exfalso
      have hpk : p ≤ k := by
        have : 2 * p ≤ q * p := Nat.mul_le_mul_right p hq
        omega
      exact hno ⟨p, hp, hpk, hd⟩
    · refine ⟨a, q, by omega, hqW, lt_of_le_of_lt ha ?_⟩
      have hmR : (k : ℝ) < ((q * p : ℕ) : ℝ) := by exact_mod_cast hkm
      have hm0 : (0 : ℝ) < ((q * p : ℕ) : ℝ) := by linarith
      rw [div_lt_div_iff₀ hm0 hk0]
      nlinarith)
  linarith

theorem erdos_1094__h2__h2__h4 : ∃ (c : ℝ),
  (0 : ℝ) < c ∧
    ∃ (k₀ : ℕ),
      ∀ (k : ℕ),
        k₀ ≤ k →
          ∀ (n : ℕ),
            k * k * k ≤ n →
              (↑n : ℝ) ≤ Real.exp (c * Real.log (↑k : ℝ) ^ (2 : ℕ)) → ∃ (p : ℕ), Nat.Prime p ∧ p ≤ k ∧ p ∣ n.choose k := by
  -- approach: Products m = q·p just above k, q ≤ k^(1/100), p prime. If p does not divide C(n,k) then n/m is within (m-k)/m of a fraction a/q. A count of the m with n/m that close to a fraction of small denominator is a small multiple of k^(3/5); BHP gives more products than that.
  -- licence: CC-BY-4.0
  refine KF_final ?_ ?_ ?_
  ·
    -- label: BHP short-interval primes
    -- claim: $\exists C > 0\ \exists k_0\ \forall k \ge k_0:\ \#\{p \text{ prime}: k < p < k + k^{21/40}\} \ge C k^{21/40}/\log k$
    -- Baker, Harman and Pintz (2001), in the form of van Doorn and Tang's `axiom bhp`.
    have h_bhp : ∃ (C : ℝ),
        (0 : ℝ) < C ∧
          ∃ (k₀ : ℕ),
            ∀ (k : ℕ),
              k₀ ≤ k →
                C * (↑k : ℝ) ^ (21 / 40 : ℝ) / Real.log (↑k : ℝ) ≤
                  (↑{p ∈ Finset.Ioo ⌊(↑k : ℝ)⌋ ⌈(↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)⌉ |
                          (0 : ℤ) < p ∧
                            Nat.Prime p.natAbs ∧ (↑k : ℝ) < (↑p : ℝ) ∧ (↑p : ℝ) < (↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)}.card :
                    ℝ) := sorry
    exact h_bhp
  ·
    -- label: many products q·p just above k, q ≤ k^(1/100)
    -- claim: $\text{BHP fails, or } \exists c_1 > 0\ \exists k_0\ \forall k \ge k_0:\ \#\{m \in (k, k + k^{3/5}]: m = qp,\ 2 \le q \le k^{1/100},\ p \text{ prime}\} \ge c_1 k^{3/5}$
    -- Here $m$, $q$, $p$ are natural numbers and BHP is the statement of the node erdos-1094--h2--h2--h1. The Lean says it with a finite set $S$ of such $m$ that has at least $c_1 k^{3/5}$ elements.
    have h_supply : (¬∃ (C : ℝ),
        (0 : ℝ) < C ∧
          ∃ (k₀ : ℕ),
            ∀ (k : ℕ),
              k₀ ≤ k →
                C * (↑k : ℝ) ^ (21 / 40 : ℝ) / Real.log (↑k : ℝ) ≤
                  (↑{p ∈ Finset.Ioo ⌊(↑k : ℝ)⌋ ⌈(↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)⌉ |
                          (0 : ℤ) < p ∧
                            Nat.Prime p.natAbs ∧ (↑k : ℝ) < (↑p : ℝ) ∧ (↑p : ℝ) < (↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)}.card :
                    ℝ)) ∨
        ∃ (c₁ : ℝ),
          (0 : ℝ) < c₁ ∧
            ∃ (k₀ : ℕ),
              ∀ (k : ℕ),
                k₀ ≤ k →
                  ∃ (S : Finset ℕ),
                    (∀ m ∈ S,
                        k < m ∧
                          (↑m : ℝ) ≤ (↑k : ℝ) + (↑k : ℝ) ^ (3 / 5 : ℝ) ∧
                            ∃ (q : ℕ) (p : ℕ),
                              (2 : ℕ) ≤ q ∧ (↑q : ℝ) ≤ (↑k : ℝ) ^ (1 / 100 : ℝ) ∧ Nat.Prime p ∧ m = q * p) ∧
                      c₁ * (↑k : ℝ) ^ (3 / 5 : ℝ) ≤ (↑S.card : ℝ) := sorry
    exact h_supply
  ·
    -- label: few m above k with n/m near a fraction a/q, q ≤ k^(1/100)
    -- claim: $\forall \eta > 0\ \exists c > 0\ \exists k_0\ \forall k \ge k_0\ \forall n,\ k^3 \le n \le \exp(c \log^2 k):\ \#\{m \in (k, k + k^{3/5}]: \exists a \in \mathbb{Z},\ 1 \le q \le k^{1/100},\ |n/m - a/q| < k^{3/5}/k\} < \eta k^{3/5}$
    -- Here $m$, $q$, $n$, $k$ are natural numbers and the inequalities are between real numbers. The Lean says it for every finite set $S$ of such $m$: $S$ has fewer than $\eta k^{3/5}$ elements.
    have h_count : ∀ (η : ℝ),
        (0 : ℝ) < η →
          ∃ (c : ℝ),
            (0 : ℝ) < c ∧
              ∃ (k₀ : ℕ),
                ∀ (k : ℕ),
                  k₀ ≤ k →
                    ∀ (n : ℕ),
                      k * k * k ≤ n →
                        (↑n : ℝ) ≤ Real.exp (c * Real.log (↑k : ℝ) ^ (2 : ℕ)) →
                          ∀ (S : Finset ℕ),
                            (∀ m ∈ S,
                                k < m ∧
                                  (↑m : ℝ) ≤ (↑k : ℝ) + (↑k : ℝ) ^ (3 / 5 : ℝ) ∧
                                    ∃ (a : ℤ) (q : ℕ),
                                      (0 : ℕ) < q ∧
                                        (↑q : ℝ) ≤ (↑k : ℝ) ^ (1 / 100 : ℝ) ∧
                                          |(↑n : ℝ) / (↑m : ℝ) - (↑a : ℝ) / (↑q : ℝ)| <
                                            (↑k : ℝ) ^ (3 / 5 : ℝ) / (↑k : ℝ)) →
                              (↑S.card : ℝ) < η * (↑k : ℝ) ^ (3 / 5 : ℝ) := sorry
    exact h_count
