open scoped Nat

/-! Hole `h_bound` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

private theorem block_bound : ∀ (f : ℕ → ℝ) (A : ℝ),
  (∀ (n : ℕ), (0 : ℝ) ≤ f n) →
    (∀ (ψ : ℝ → ℝ),
        ContDiff ℝ (2 : WithTop ℕ∞) ψ →
          HasCompactSupport ψ →
            Function.support ψ ⊆ Set.Ioi (0 : ℝ) →
              Filter.Tendsto (fun (X : ℝ) => (∑' (n : ℕ), f n * ψ ((↑n : ℝ) / X)) / X) Filter.atTop
                (nhds (A * ∫ (x : ℝ), ψ x))) →
      ∃ (c : ℝ) (N₀ : ℕ), ∀ N : ℕ, N₀ ≤ N →
      (∑ n ∈ Finset.range (N + 1), f n) - (∑ n ∈ Finset.range (N / 4 + 1), f n) ≤ c * N := by
  intro f A hf hsmooth
  let bump : ContDiffBump (1 : ℝ) := ⟨3 / 4, 1, by norm_num, by norm_num⟩
  have hψ1 : ContDiff ℝ (2 : WithTop ℕ∞) (bump : ℝ → ℝ) := by exact_mod_cast bump.contDiff (n := 2)
  have hψ2 : HasCompactSupport (bump : ℝ → ℝ) := bump.hasCompactSupport
  have hsupp : Function.support (bump : ℝ → ℝ) = Metric.ball (1 : ℝ) 1 := bump.support_eq
  have hψ3 : Function.support (bump : ℝ → ℝ) ⊆ Set.Ioi (0 : ℝ) := by
    rw [hsupp]; intro x hx
    rw [Metric.mem_ball, Real.dist_eq] at hx
    have := abs_lt.1 hx
    show (0 : ℝ) < x; linarith
  have h := hsmooth bump hψ1 hψ2 hψ3
  set L := A * ∫ x : ℝ, (bump : ℝ → ℝ) x with hL
  have hev : ∀ᶠ X : ℝ in Filter.atTop, (∑' (n : ℕ), f n * bump ((↑n : ℝ) / X)) / X ≤ L + 1 :=
    h.eventually (eventually_le_nhds (lt_add_one L))
  obtain ⟨X₀, hX₀⟩ := Filter.eventually_atTop.1 hev
  refine ⟨L + 1, ⌈X₀⌉₊ + 1, ?_⟩
  intro N hN
  have hNpos : (0 : ℝ) < N := by
    have : 1 ≤ N := by omega
    exact_mod_cast this
  have hNX : X₀ ≤ N := by
    have h1 : X₀ ≤ ⌈X₀⌉₊ := Nat.le_ceil X₀
    have h2 : ((⌈X₀⌉₊ : ℕ) : ℝ) ≤ N := by exact_mod_cast (by omega : ⌈X₀⌉₊ ≤ N)
    linarith
  have hsum : (∑' (n : ℕ), f n * bump ((↑n : ℝ) / N)) ≤ (L + 1) * N := by
    have := hX₀ N hNX
    rwa [div_le_iff₀ hNpos] at this
  -- the terms vanish beyond 2N
  have hvan : ∀ n ∉ Finset.range (2 * N), f n * bump ((↑n : ℝ) / N) = 0 := by
    intro n hn
    rw [Finset.mem_range, not_lt] at hn
    have hzero : (bump : ℝ → ℝ) ((↑n : ℝ) / N) = 0 := by
      rw [← Function.notMem_support, hsupp, Metric.mem_ball, Real.dist_eq, not_lt]
      have h2 : (2 : ℝ) ≤ (↑n : ℝ) / N := by
        rw [le_div_iff₀ hNpos]; exact_mod_cast (by omega : 2 * N ≤ n)
      rw [abs_of_nonneg (by linarith)]; linarith
    rw [hzero, mul_zero]
  have hsummable : Summable (fun n : ℕ => f n * bump ((↑n : ℝ) / N)) :=
    (hasSum_sum_of_ne_finset_zero hvan).summable
  have hnonneg : ∀ n, 0 ≤ f n * bump ((↑n : ℝ) / N) := fun n => mul_nonneg (hf n) bump.nonneg
  -- the block, as a sum over Ico, is dominated by the tsum
  have hblock : (∑ n ∈ Finset.range (N + 1), f n) - (∑ n ∈ Finset.range (N / 4 + 1), f n)
      = ∑ n ∈ Finset.Ico (N / 4 + 1) (N + 1), f n * bump ((↑n : ℝ) / N) := by
    have e1 : ∑ n ∈ Finset.Ico (N / 4 + 1) (N + 1), f n
        = (∑ n ∈ Finset.range (N + 1), f n) - (∑ n ∈ Finset.range (N / 4 + 1), f n) :=
      Finset.sum_Ico_eq_sub f (by omega : N / 4 + 1 ≤ N + 1)
    rw [← e1]
    apply Finset.sum_congr rfl
    intro n hn
    rw [Finset.mem_Ico] at hn
    have hone : (bump : ℝ → ℝ) ((↑n : ℝ) / N) = 1 := by
      apply bump.one_of_mem_closedBall
      rw [Metric.mem_closedBall, Real.dist_eq, abs_le]
      have hlo : (1 : ℝ) / 4 ≤ (↑n : ℝ) / N := by
        rw [div_le_div_iff₀ (by norm_num) hNpos]; exact_mod_cast (by omega : 1 * N ≤ ↑n * 4)
      have hhi : (↑n : ℝ) / N ≤ 1 := by
        rw [div_le_one hNpos]; exact_mod_cast (by omega : n ≤ N)
      show (-(3 / 4 : ℝ) ≤ (↑n : ℝ) / N - 1) ∧ ((↑n : ℝ) / N - 1 ≤ 3 / 4)
      constructor <;> linarith
    rw [hone, mul_one]
  rw [hblock]
  calc ∑ n ∈ Finset.Ico (N / 4 + 1) (N + 1), f n * bump ((↑n : ℝ) / N)
      ≤ ∑' (n : ℕ), f n * bump ((↑n : ℝ) / N) :=
        hsummable.sum_le_tsum _ (fun n _ => hnonneg n)
    _ ≤ (L + 1) * N := hsum

private theorem dyadic_bound (S : ℕ → ℝ) (hS0 : S 0 = 0) (hnn : ∀ N, 0 ≤ S N) (hmono : Monotone S)
    (c : ℝ) (N₀ : ℕ) (hblock : ∀ N, N₀ ≤ N → S (N + 1) - S (N / 4 + 1) ≤ c * N) :
    ∃ C : ℝ, ∀ N : ℕ, S N ≤ C * N := by
  set M := max N₀ 3 with hM
  refine ⟨max (2 * c) (S (M + 1)), ?_⟩
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    rcases Nat.eq_zero_or_pos N with h0 | hpos
    · subst h0; simp [hS0]
    by_cases hle : N ≤ M + 1
    · -- base: S N ≤ S (M+1) ≤ C ≤ C * N
      have h1 : S N ≤ S (M + 1) := hmono hle
      have h2 : S (M + 1) ≤ max (2 * c) (S (M + 1)) := le_max_right _ _
      have h3 : (1 : ℝ) ≤ N := by exact_mod_cast hpos
      have h4 : 0 ≤ max (2 * c) (S (M + 1)) := le_trans (hnn _) h2
      nlinarith
    · push Not at hle
      have hN0 : N₀ ≤ N - 1 := by omega
      have hN4 : 4 ≤ N := by omega
      have hb := hblock (N - 1) hN0
      have hsub : N - 1 + 1 = N := by omega
      rw [hsub] at hb
      have hsmall : (N - 1) / 4 + 1 < N := by omega
      have hih := ih ((N - 1) / 4 + 1) hsmall
      have hcast : ((N - 1 : ℕ) : ℝ) = (N : ℝ) - 1 := by
        rw [Nat.cast_sub (by omega)]; simp
      have hdiv : (((N - 1) / 4 + 1 : ℕ) : ℝ) ≤ (N : ℝ) / 4 + 1 := by
        push_cast
        have := Nat.cast_div_le (α := ℝ) (m := N - 1) (n := 4)
        rw [hcast] at this
        push_cast at this
        linarith
      set C := max (2 * c) (S (M + 1)) with hC
      have hC0 : 0 ≤ C := le_trans (hnn _) (le_max_right _ _)
      have hC2 : 2 * c ≤ C := le_max_left _ _
      have hNr : (4 : ℝ) ≤ N := by exact_mod_cast hN4
      -- S N ≤ S ((N-1)/4+1) + c (N-1) ≤ C ((N-1)/4+1) + c (N-1) ≤ C N
      have hstep : S N ≤ C * (((N - 1) / 4 + 1 : ℕ) : ℝ) + c * ((N : ℝ) - 1) := by
        rw [hcast] at hb; linarith
      have hmul : C * (((N - 1) / 4 + 1 : ℕ) : ℝ) ≤ C * ((N : ℝ) / 4 + 1) :=
        mul_le_mul_of_nonneg_left hdiv hC0
      nlinarith

theorem erdos_1094__h3__h3__h1__h1__h1__h1__h1__h1 : ∀ (f : ℕ → ℝ) (A : ℝ),
  (∀ (n : ℕ), (0 : ℝ) ≤ f n) →
    (∀ (ψ : ℝ → ℝ),
        ContDiff ℝ (2 : WithTop ℕ∞) ψ →
          HasCompactSupport ψ →
            Function.support ψ ⊆ Set.Ioi (0 : ℝ) →
              Filter.Tendsto (fun (X : ℝ) => (∑' (n : ℕ), f n * ψ ((↑n : ℝ) / X)) / X) Filter.atTop
                (nhds (A * ∫ (x : ℝ), ψ x))) →
      ∃ (C : ℝ), ∀ (N : ℕ), ∑ n ∈ Finset.range N, f n ≤ C * (↑N : ℝ) := by
  intro f A hf hsmooth
  obtain ⟨c, N₀, hb⟩ := block_bound f A hf hsmooth
  exact dyadic_bound (fun N => ∑ n ∈ Finset.range N, f n) (by simp)
    (fun N => Finset.sum_nonneg (fun i _ => hf i))
    (fun a b hab => Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono hab) (fun i _ _ => hf i))
    c N₀ hb
