import Mathlib
import Nodes.«erdos-1094--h2--h2--h4--h3».Context
import Nodes.«erdos-1094--h2--h2--h2--h3--h1--h1».Proof

open scoped Nat

/-! Hole `h_count` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

private noncomputable def smoothDenom (k x : ℝ) : ℝ :=
  k / 2 + (x + k / 2) * Real.smoothTransition ((4 * x + 2 * k) / k)

/-- The globally smooth modification of `f(x) = (-1)^r n / (k + x)`. -/
private noncomputable def fK (n k : ℝ) (r : ℕ) (x : ℝ) : ℝ := ((-1 : ℝ) ^ r * n) / smoothDenom k x

/-
`smoothDenom k` is positive everywhere when `k > 0`.
-/
private lemma smoothDenom_pos (k : ℝ) (hk : 0 < k) (x : ℝ) : 0 < smoothDenom k x := by
  unfold smoothDenom;
  by_cases h : x + k / 2 ≥ 0 <;> simp_all +decide;
  · exact add_pos_of_pos_of_nonneg ( half_pos hk ) ( mul_nonneg h ( Real.smoothTransition.nonneg _ ) );
  · rw [ Real.smoothTransition.zero_of_nonpos ] <;> nlinarith [ mul_div_cancel₀ ( 4 * x + 2 * k ) hk.ne' ]

/-
`smoothDenom k x = k + x` for `x ≥ -k/4`.
-/
private lemma smoothDenom_eq (k : ℝ) (hk : 0 < k) (x : ℝ) (hx : -k / 4 ≤ x) :
    smoothDenom k x = k + x := by
  unfold smoothDenom; rw [ Real.smoothTransition.one_of_one_le ( by rw [ le_div_iff₀ hk ] ; linarith ) ] ; ring;

/-
`smoothDenom k` is smooth.
-/
private lemma smoothDenom_contDiff (k : ℝ) (m : ℕ∞) :
    ContDiff ℝ (m : WithTop ℕ∞) (smoothDenom k) := by
  refine' ContDiff.add contDiff_const _;
  refine' ContDiff.mul ( contDiff_id.add contDiff_const ) _;
  exact ContDiff.comp ( Real.smoothTransition.contDiff ) ( by exact ContDiff.div_const ( by exact ContDiff.add ( contDiff_const.mul contDiff_id ) contDiff_const ) _ )

/-
`fK n k r` is smooth, given `k > 0`.
-/
private lemma fK_contDiff (n k : ℝ) (hk : 0 < k) (r : ℕ) (m : ℕ∞) :
    ContDiff ℝ (m : WithTop ℕ∞) (fK n k r) := by
  exact ContDiff.div ( contDiff_const ) ( smoothDenom_contDiff k m ) fun x => ne_of_gt ( smoothDenom_pos k hk x )

/-
The iterated derivatives of `fK` on `[0, ∞)` are given by the explicit formula
for `(-1)^r n / (k + x)`.
-/
private lemma iteratedDeriv_fK (n k : ℝ) (hk : 0 < k) (r j : ℕ) (x : ℝ) (hx : 0 ≤ x) :
    iteratedDeriv j (fK n k r) x
      = ((-1 : ℝ) ^ r * n) * ((-1) ^ j * (j ! : ℝ) * (k + x) ^ (-1 - (j : ℤ))) := by
  -- Apply the equality we've shown in the neighborhood to the specific point x.
  have h_eq_at_x : iteratedDeriv j (fK n k r) x = iteratedDeriv j (fun y => (-1 : ℝ) ^ r * n / (k + y)) x := by
    apply Filter.EventuallyEq.iteratedDeriv_eq
    generalize_proofs at *; (
    filter_upwards [ lt_mem_nhds ( show x > -k / 4 by linarith ) ] with y hy using by unfold fK; rw [ smoothDenom_eq k hk y ( by linarith ) ] ;)
  generalize_proofs at *; (
  -- Apply the chain rule to compute the derivative.
  have h_chain : iteratedDeriv j (fun y => (-1 : ℝ) ^ r * n / (k + y)) x = (-1 : ℝ) ^ r * n * iteratedDeriv j (fun y => 1 / (k + y)) x := by
    convert iteratedDeriv_const_mul ( ( -1 ) ^ r * n ) _ using 1 ; norm_num [ div_eq_mul_inv ];
    have hc : ContDiffAt ℝ (↑j) (fun y : ℝ => k + y) x := contDiffAt_const.add contDiffAt_id
    have h2 := hc.inv (by show k + x ≠ 0; intro h; linarith)
    have e : (fun y : ℝ => 1 / (k + y)) = (fun y => k + y)⁻¹ := by
      funext y; simp [one_div]
    rw [e]; exact h2
  generalize_proofs at *; (
  convert h_eq_at_x.trans h_chain using 1
  generalize_proofs at *; (
  -- By definition of $fK$, we know that its $j$-th derivative is given by the formula.
  have h_deriv : iteratedDeriv j (fun y => 1 / (k + y)) x = (-1 : ℝ) ^ j * (Nat.factorial j) * (k + x) ^ (-1 - j : ℤ) := by
    have hs : IsOpen {y : ℝ | (0:ℝ) < y} := isOpen_lt continuous_const continuous_id
    have hmem : k + x ∈ {y : ℝ | (0:ℝ) < y} := by simp; linarith
    have heq := iteratedDerivWithin_of_isOpen (n := j) (f := fun y : ℝ => 1/y) hs hmem
    rw [show (fun y : ℝ => 1 / (k + y)) = (fun z : ℝ => (fun y : ℝ => 1/y) (k + z)) from rfl,
        iteratedDeriv_comp_const_add]
    simp only []
    rw [← heq]
    exact iteratedDerivWithin_one_div j hs hmem
  generalize_proofs at *; (
  grind +splitIndPred))))

/-
Absolute value of the `r`-th derivative of `fK` on `[0, ∞)`.
-/
private lemma abs_iteratedDeriv_r (n k : ℝ) (hk : 0 < k) (hn : 0 < n) (r : ℕ) (x : ℝ)
    (hx : 0 ≤ x) :
    |iteratedDeriv r (fK n k r) x| = (n * (r ! : ℝ)) / (k + x) ^ (r + 1) := by
  rw [ iteratedDeriv_fK n k hk r r x hx ] ; norm_num [ abs_mul, abs_div, abs_pow, abs_of_pos hn, abs_of_pos ( add_pos_of_pos_of_nonneg hk hx ) ] ; ring_nf;
  rw [ show ( -1 - r : ℤ ) = - ( r + 1 ) by ring, zpow_neg ] ; norm_cast ; ring;

/-
Absolute value of the `(r+1)`-th derivative of `fK` on `[0, ∞)`.
-/
private lemma abs_iteratedDeriv_r1 (n k : ℝ) (hk : 0 < k) (hn : 0 < n) (r : ℕ) (x : ℝ)
    (hx : 0 ≤ x) :
    |iteratedDeriv (r + 1) (fK n k r) x| = (n * ((r + 1)! : ℝ)) / (k + x) ^ (r + 2) := by
  convert abs_iteratedDeriv_r n k hk hn ( r + 1 ) x hx using 1;
  unfold fK;
  norm_num [ pow_succ', div_eq_mul_inv ]

/-
The key ratio inequality: `(1 + u)^{r+1} ≤ 2` when `2 r u ≤ 1`.
-/
private lemma key_ratio (r : ℕ) (hr : 2 ≤ r) (u : ℝ) (hu : 0 ≤ u) (hru : 2 * (r : ℝ) * u ≤ 1) :
    (1 + u) ^ (r + 1) ≤ 2 := by
  -- For r ≥ 3, we have u ≤ 1/(2*r) ≤ 1/6, and (1+u)^4 ≤ 2.
  by_cases hr_ge_3 : r ≥ 3;
  · -- Using the exponential bound, we have $(1 + u)^{r+1} \leq \exp(u(r+1))$.
    have h_exp_bound : (1 + u) ^ (r + 1) ≤ Real.exp (u * (r + 1)) := by
      rw [ ← Real.rpow_natCast, Real.rpow_def_of_pos ( by positivity ) ];
      exact Real.exp_le_exp.mpr ( by push_cast; nlinarith [ Real.log_le_sub_one_of_pos ( by linarith : 0 < 1 + u ) ] );
    refine le_trans h_exp_bound ?_;
    rw [ ← Real.log_le_log_iff ( by positivity ) ( by positivity ), Real.log_exp ];
    exact le_trans ( by nlinarith [ show ( r : ℝ ) ≥ 3 by norm_cast ] ) ( Real.log_two_gt_d9.le );
  · interval_cases r ; norm_num at * ; nlinarith [ sq_nonneg u ]

private theorem kf_app
    (hK : ∀ (r : ℕ), 2 ≤ r → ∀ (N : ℝ), 0 < N → ∀ (W : ℝ), 1 ≤ W → ∀ (δ : ℝ), 0 < δ →
      ∀ (lam : ℝ), 1 ≤ lam → ∀ (D_r : ℝ), 0 < D_r → ∀ (D_r1 : ℝ), 0 < D_r1 →
      ∀ (f : ℝ → ℝ), ContDiff ℝ (↑(r + 1) : ℕ∞) f →
      (∀ x ∈ Set.Icc (0 : ℝ) N, D_r / 2 ≤ |iteratedDeriv r f x|) →
      (∀ x ∈ Set.Icc (0 : ℝ) N, |iteratedDeriv r f x| ≤ D_r) →
      (∀ x ∈ Set.Icc (0 : ℝ) N, |iteratedDeriv (r + 1) f x| ≤ D_r1) →
      ∀ (S : Finset ℤ), (∀ u ∈ S, (0 : ℤ) ≤ u ∧ u ≤ ⌊N⌋) →
      (∀ u ∈ S, ∃ (v : ℤ) (w : ℕ), 0 < w ∧ (w : ℝ) ≤ W ∧ |f (u : ℝ) - (v : ℝ) / (w : ℝ)| < δ) →
      (S.card : ℝ) < (65536 : ℝ) * N *
      ((D_r * lam ^ (r : ℕ) * W ^ 2) ^ ((2 * (r : ℝ) - 1)⁻¹) +
       (δ * W ^ 2 / (D_r * lam ^ (r : ℕ))) ^ (((r : ℝ) - 1)⁻¹) +
       (D_r1 * lam * W ^ 2 / D_r) ^ ((2 * (r : ℝ))⁻¹)) +
      2 * (r : ℝ) * lam)
    (lam H W δ : ℝ) (hlam : 1 ≤ lam) (hH : 0 < H) (hW : 1 ≤ W) (hδ : 0 < δ)
    (n k r : ℕ) (hk : 1 ≤ k) (hn : 1 ≤ n) (hr2 : 2 ≤ r)
    (hrat : ((k : ℝ) + H) ^ (r + 1) ≤ 2 * (k : ℝ) ^ (r + 1))
    (S : Finset ℕ)
    (hS : ∀ m ∈ S, k < m ∧ (m : ℝ) ≤ (k : ℝ) + H ∧
      ∃ (a : ℤ) (q : ℕ), 0 < q ∧ (q : ℝ) ≤ W ∧ |(n : ℝ) / (m : ℝ) - (a : ℝ) / (q : ℝ)| < δ) :
    (S.card : ℝ) < (65536 : ℝ) * H *
      (((n : ℝ) * (r ! : ℝ) / (k : ℝ) ^ (r + 1) * lam ^ r * W ^ 2) ^ ((2 * (r : ℝ) - 1)⁻¹) +
       (δ * W ^ 2 / ((n : ℝ) * (r ! : ℝ) / (k : ℝ) ^ (r + 1) * lam ^ r)) ^ (((r : ℝ) - 1)⁻¹) +
       ((n : ℝ) * ((r + 1)! : ℝ) / (k : ℝ) ^ (r + 2) * lam * W ^ 2 /
          ((n : ℝ) * (r ! : ℝ) / (k : ℝ) ^ (r + 1))) ^ ((2 * (r : ℝ))⁻¹)) +
      2 * (r : ℝ) * lam := by
  have hkR : (0 : ℝ) < (k : ℝ) := by exact_mod_cast hk
  have hnR : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
  have hcard : (S.image (fun m : ℕ => (m : ℤ) - (k : ℤ))).card = S.card := by
    apply Finset.card_image_of_injective
    intro a b hab
    have hab' : (a : ℤ) - (k : ℤ) = (b : ℤ) - (k : ℤ) := hab
    omega
  have h1 : ∀ x ∈ Set.Icc (0 : ℝ) H, (n : ℝ) * (r ! : ℝ) / (k : ℝ) ^ (r + 1) / 2 ≤
      |iteratedDeriv r (fK (n : ℝ) (k : ℝ) r) x| := by
    intro x hx
    rw [abs_iteratedDeriv_r (n : ℝ) (k : ℝ) hkR hnR r x hx.1]
    have hx' : ((k : ℝ) + x) ^ (r + 1) ≤ 2 * (k : ℝ) ^ (r + 1) :=
      le_trans (pow_le_pow_left₀ (by linarith [hx.1]) (by linarith [hx.2]) _) hrat
    have hpos : (0 : ℝ) < ((k : ℝ) + x) ^ (r + 1) := pow_pos (by linarith [hx.1]) _
    calc (n : ℝ) * (r ! : ℝ) / (k : ℝ) ^ (r + 1) / 2
        = (n : ℝ) * (r ! : ℝ) / (2 * (k : ℝ) ^ (r + 1)) := by ring
      _ ≤ (n : ℝ) * (r ! : ℝ) / ((k : ℝ) + x) ^ (r + 1) :=
          div_le_div_of_nonneg_left (by positivity) hpos hx'
  have h2 : ∀ x ∈ Set.Icc (0 : ℝ) H, |iteratedDeriv r (fK (n : ℝ) (k : ℝ) r) x| ≤
      (n : ℝ) * (r ! : ℝ) / (k : ℝ) ^ (r + 1) := by
    intro x hx
    rw [abs_iteratedDeriv_r (n : ℝ) (k : ℝ) hkR hnR r x hx.1]
    exact div_le_div_of_nonneg_left (by positivity) (by positivity)
      (pow_le_pow_left₀ hkR.le (by linarith [hx.1]) _)
  have h3 : ∀ x ∈ Set.Icc (0 : ℝ) H, |iteratedDeriv (r + 1) (fK (n : ℝ) (k : ℝ) r) x| ≤
      (n : ℝ) * ((r + 1)! : ℝ) / (k : ℝ) ^ (r + 2) := by
    intro x hx
    rw [abs_iteratedDeriv_r1 (n : ℝ) (k : ℝ) hkR hnR r x hx.1]
    exact div_le_div_of_nonneg_left (by positivity) (by positivity)
      (pow_le_pow_left₀ hkR.le (by linarith [hx.1]) _)
  have h4 : ∀ u ∈ S.image (fun m : ℕ => (m : ℤ) - (k : ℤ)), (0 : ℤ) ≤ u ∧ u ≤ ⌊H⌋ := by
    intro u hu
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.1 hu
    obtain ⟨hkm, hmH, -⟩ := hS m hm
    refine ⟨by omega, Int.le_floor.2 ?_⟩
    push_cast
    linarith
  have h5 : ∀ u ∈ S.image (fun m : ℕ => (m : ℤ) - (k : ℤ)), ∃ (v : ℤ) (w : ℕ), 0 < w ∧ (w : ℝ) ≤ W ∧
      |fK (n : ℝ) (k : ℝ) r (u : ℝ) - (v : ℝ) / (w : ℝ)| < δ := by
    intro u hu
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.1 hu
    obtain ⟨hkm, hmH, a, q, hq, hqW, hd⟩ := hS m hm
    have hkmR : (k : ℝ) < (m : ℝ) := by exact_mod_cast hkm
    refine ⟨(-1) ^ r * a, q, hq, hqW, ?_⟩
    have hu0 : (((m : ℤ) - (k : ℤ) : ℤ) : ℝ) = (m : ℝ) - (k : ℝ) := by push_cast; ring
    have e : fK (n : ℝ) (k : ℝ) r ((m : ℝ) - (k : ℝ)) = (-1 : ℝ) ^ r * (n : ℝ) / (m : ℝ) := by
      unfold fK
      rw [smoothDenom_eq (k : ℝ) hkR _ (by linarith)]
      congr 1
      ring
    rw [hu0, e]
    have e2 : (-1 : ℝ) ^ r * (n : ℝ) / (m : ℝ) - (((-1) ^ r * a : ℤ) : ℝ) / (q : ℝ) =
        (-1 : ℝ) ^ r * ((n : ℝ) / (m : ℝ) - (a : ℝ) / (q : ℝ)) := by
      push_cast
      ring
    rw [e2, abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul]
    exact hd
  have hh := hK r hr2 H hH W hW δ hδ lam hlam ((n : ℝ) * (r ! : ℝ) / (k : ℝ) ^ (r + 1)) (by positivity)
    ((n : ℝ) * ((r + 1)! : ℝ) / (k : ℝ) ^ (r + 2)) (by positivity) (fK (n : ℝ) (k : ℝ) r)
    (fK_contDiff _ _ hkR _ _) h1 h2 h3 (S.image (fun m : ℕ => (m : ℤ) - (k : ℤ))) h4 h5
  rw [hcard] at hh
  exact hh

private lemma kf_root (x τ e : ℝ) (m : ℕ) (hm : 0 < m) (he : e = (m : ℝ)) (hx : 0 ≤ x) (hτ : 0 ≤ τ)
    (h : x ≤ τ ^ m) : x ^ (e⁻¹) ≤ τ := by
  subst he
  calc x ^ ((m : ℝ)⁻¹) ≤ (τ ^ m) ^ ((m : ℝ)⁻¹) :=
        Real.rpow_le_rpow hx h (inv_nonneg.2 (Nat.cast_nonneg m))
    _ = τ := Real.pow_rpow_inv_natCast hτ hm.ne'

private lemma kf_conds (x τ η : ℝ) (R r : ℕ) (lam Y : ℝ) (hx : 1 ≤ x) (hτ0 : 0 < τ) (hτ1 : τ < 1)
    (hη : 0 < η) (hrR : r ≤ R) (hlam1 : 1 ≤ lam) (hlam3 : lam ^ 3 ≤ x)
    (hE1 : 2 * ((R : ℝ) + 1) ≤ x ^ (1 / 4 : ℝ)) (hE2 : 2 * ((R : ℝ) + 1) ≤ η * x ^ (1 / 4 : ℝ))
    (hτR : x ^ (-(1 / 100) : ℝ) ≤ τ ^ R)
    (hY : Y * (x ^ (1 / 100 : ℝ)) ^ 2 * τ = τ ^ (2 * r)) :
    2 * (r : ℝ) * x ^ (3 / 5 : ℝ) ≤ x ∧
    x ^ (3 / 5 : ℝ) / x * (x ^ (1 / 100 : ℝ)) ^ 2 * τ ≤ τ ^ r * Y ∧
    ((r : ℝ) + 1) * lam * (x ^ (1 / 100 : ℝ)) ^ 2 ≤ τ ^ (2 * r) * x ∧
    2 * (r : ℝ) * lam ≤ η * x ^ (3 / 5 : ℝ) := by
  have hx0 : 0 < x := by linarith
  have hrR' : (r : ℝ) ≤ (R : ℝ) := by exact_mod_cast hrR
  have hr0 : (0 : ℝ) ≤ r := Nat.cast_nonneg r
  have hlam0 : (0 : ℝ) ≤ lam := by linarith
  have hpw : ∀ a b : ℝ, a ≤ b → x ^ a ≤ x ^ b := fun a b h => Real.rpow_le_rpow_of_exponent_le hx h
  have hadd : ∀ a b : ℝ, x ^ a * x ^ b = x ^ (a + b) := fun a b => (Real.rpow_add hx0 a b).symm
  have hW2 : (x ^ (1 / 100 : ℝ)) ^ 2 = x ^ (1 / 50 : ℝ) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le]; norm_num
  have hx3 : (x ^ (1 / 3 : ℝ)) ^ 3 = x := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le]; norm_num
  have hlam : lam ≤ x ^ (1 / 3 : ℝ) := by
    by_contra h
    rw [not_le] at h
    have h3 := pow_lt_pow_left₀ h (by positivity) (by norm_num : (3 : ℕ) ≠ 0)
    linarith
  have hτ2 : x ^ (-(1 / 50) : ℝ) ≤ τ ^ (2 * r) :=
    calc x ^ (-(1 / 50) : ℝ) = (x ^ (-(1 / 100) : ℝ)) ^ 2 := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le]; norm_num
      _ ≤ (τ ^ R) ^ 2 := pow_le_pow_left₀ (by positivity) hτR 2
      _ = τ ^ (2 * R) := by rw [← pow_mul, mul_comm]
      _ ≤ τ ^ (2 * r) := pow_le_pow_of_le_one hτ0.le hτ1.le (by omega)
  have hτ3 : x ^ (-(3 / 100) : ℝ) ≤ τ ^ (3 * r) :=
    calc x ^ (-(3 / 100) : ℝ) = (x ^ (-(1 / 100) : ℝ)) ^ 3 := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le]; norm_num
      _ ≤ (τ ^ R) ^ 3 := pow_le_pow_left₀ (by positivity) hτR 3
      _ = τ ^ (3 * R) := by rw [← pow_mul, mul_comm]
      _ ≤ τ ^ (3 * r) := pow_le_pow_of_le_one hτ0.le hτ1.le (by omega)
  have hr14 : 2 * (r : ℝ) ≤ x ^ (1 / 4 : ℝ) := by linarith
  have hr14' : (r : ℝ) + 1 ≤ x ^ (1 / 4 : ℝ) := by linarith
  refine ⟨?_, ?_, ?_, ?_⟩
  · calc 2 * (r : ℝ) * x ^ (3 / 5 : ℝ) ≤ x ^ (1 / 4 : ℝ) * x ^ (3 / 5 : ℝ) :=
          mul_le_mul_of_nonneg_right hr14 (by positivity)
      _ = x ^ ((1 / 4 : ℝ) + (3 / 5 : ℝ)) := hadd _ _
      _ ≤ x ^ (1 : ℝ) := hpw _ _ (by norm_num)
      _ = x := Real.rpow_one x
  · have hδ : x ^ (3 / 5 : ℝ) / x = x ^ (-(2 / 5) : ℝ) := by
      rw [show (-(2 / 5) : ℝ) = 3 / 5 - 1 by norm_num, Real.rpow_sub hx0, Real.rpow_one]
    have key : (x ^ (3 / 5 : ℝ) / x * (x ^ (1 / 100 : ℝ)) ^ 2 * τ) * ((x ^ (1 / 100 : ℝ)) ^ 2 * τ) ≤
        (τ ^ r * Y) * ((x ^ (1 / 100 : ℝ)) ^ 2 * τ) := by
      have e1 : (τ ^ r * Y) * ((x ^ (1 / 100 : ℝ)) ^ 2 * τ) = τ ^ (3 * r) := by
        rw [show τ ^ r * Y * ((x ^ (1 / 100 : ℝ)) ^ 2 * τ) = τ ^ r * (Y * (x ^ (1 / 100 : ℝ)) ^ 2 * τ) by ring,
          hY, ← pow_add]
        congr 1
        omega
      rw [e1, hδ, hW2]
      have e2 : x ^ (-(2 / 5) : ℝ) * x ^ (1 / 50 : ℝ) * τ * (x ^ (1 / 50 : ℝ) * τ) =
          x ^ (-(9 / 25) : ℝ) * τ ^ 2 := by
        rw [show (-(9 / 25) : ℝ) = -(2 / 5) + 1 / 50 + 1 / 50 by norm_num, Real.rpow_add hx0,
          Real.rpow_add hx0]
        ring
      rw [e2]
      calc x ^ (-(9 / 25) : ℝ) * τ ^ 2 ≤ x ^ (-(3 / 100) : ℝ) * 1 :=
            mul_le_mul (hpw _ _ (by norm_num)) (pow_le_one₀ hτ0.le hτ1.le) (by positivity) (by positivity)
        _ = x ^ (-(3 / 100) : ℝ) := mul_one _
        _ ≤ τ ^ (3 * r) := hτ3
    exact le_of_mul_le_mul_right key (by positivity)
  · calc ((r : ℝ) + 1) * lam * (x ^ (1 / 100 : ℝ)) ^ 2
        ≤ x ^ (1 / 4 : ℝ) * x ^ (1 / 3 : ℝ) * x ^ (1 / 50 : ℝ) := by
          rw [hW2]
          exact mul_le_mul (mul_le_mul hr14' hlam hlam0 (by positivity)) le_rfl (by positivity) (by positivity)
      _ = x ^ ((1 / 4 : ℝ) + 1 / 3 + 1 / 50) := by rw [hadd, hadd]
      _ ≤ x ^ (-(1 / 50) + 1 : ℝ) := hpw _ _ (by norm_num)
      _ = x ^ (-(1 / 50) : ℝ) * x := by rw [Real.rpow_add hx0, Real.rpow_one]
      _ ≤ τ ^ (2 * r) * x := mul_le_mul_of_nonneg_right hτ2 hx0.le
  · have hR0 : (0 : ℝ) ≤ 2 * ((R : ℝ) + 1) := by positivity
    calc 2 * (r : ℝ) * lam ≤ (η * x ^ (1 / 4 : ℝ)) * x ^ (1 / 3 : ℝ) :=
          mul_le_mul (by linarith) hlam hlam0 (le_trans hR0 hE2)
      _ = η * x ^ ((1 / 4 : ℝ) + 1 / 3) := by rw [mul_assoc, hadd]
