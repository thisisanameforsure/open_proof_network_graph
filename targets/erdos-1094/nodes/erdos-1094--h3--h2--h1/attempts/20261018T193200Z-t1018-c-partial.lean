theorem erdos_1094__h3__h2__h1 : ∃ (c : ℝ),
  (0 : ℝ) < c ∧
    ∃ (K₂ : ℕ), ∀ (n k : ℕ), K₂ < k → (2 : ℕ) * k ≤ n → (n.choose k).minFac > k → (↑k : ℝ) ^ ((1 : ℝ) + c) < (↑n : ℝ) := by
  -- approach: n ≥ k² is immediate with c ≤ 1/2; only the range n < k² needs EES
  -- licence: CC-BY-4.0
  -- label: EES bound below k squared
  -- claim: $\exists c>0\,\exists K\,\forall n,k:\ K<k,\ 2k\le n<k^2,\ \mathrm{lpf}\binom{n}{k}>k \Rightarrow k^{1+c}<n$
  -- The Ecklund–Erdős–Selfridge bound restricted to the only range where it has content.
  have h_lt : ∃ (c : ℝ), (0 : ℝ) < c ∧ ∃ (K : ℕ), ∀ (n k : ℕ), K < k → (2 : ℕ) * k ≤ n → n < k * k →
      (n.choose k).minFac > k → (↑k : ℝ) ^ ((1 : ℝ) + c) < (↑n : ℝ) := sorry
  obtain ⟨c, hc, K, hK⟩ := h_lt
  refine ⟨min c (1 / 2), lt_min hc (by norm_num), K + 1, fun n k hk h2 hmf => ?_⟩
  have hk1 : (1 : ℝ) < (k : ℝ) := by exact_mod_cast (show 1 < k by omega)
  by_cases hn : n < k * k
  · calc (k : ℝ) ^ ((1 : ℝ) + min c (1 / 2)) ≤ (k : ℝ) ^ ((1 : ℝ) + c) :=
          Real.rpow_le_rpow_of_exponent_le hk1.le (by linarith [min_le_left c (1 / 2)])
      _ < (n : ℝ) := hK n k (by omega) h2 hn hmf
  · replace hn := not_lt.mp hn
    have hnk : ((k : ℝ) * k) ≤ (n : ℝ) := by exact_mod_cast hn
    calc (k : ℝ) ^ ((1 : ℝ) + min c (1 / 2)) ≤ (k : ℝ) ^ ((1 : ℝ) + 1 / 2) :=
          Real.rpow_le_rpow_of_exponent_le hk1.le (by linarith [min_le_right c (1 / 2)])
      _ < (k : ℝ) ^ (2 : ℝ) := Real.rpow_lt_rpow_of_exponent_lt hk1 (by norm_num)
      _ = (k : ℝ) * k := by rw [Real.rpow_two, sq]
      _ ≤ (n : ℝ) := hnk
