  obtain ⟨K, hK⟩ := h_residue
  refine ⟨K, fun n k hk hn hT hfac hmin hprime hndvd => hK n k hk hn hT hfac ?_ ?_ hprime hndvd⟩
  · -- a prime p ≤ k is at most n / k, so it does not divide C(n,k)
