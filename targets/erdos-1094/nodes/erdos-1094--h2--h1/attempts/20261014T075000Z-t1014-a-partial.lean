import Mathlib
import Nodes.«erdos-1094--h2--h1».Context

open scoped Nat

/-! Hole `h_lo` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem erdos_1094__h2__h1 : ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → k * k ≤ n → n < k * k * k → (n.choose k).minFac > n / k → k ≤ K := by
  -- annex: 6c7d3be4efeecc319f87dc55a1638245a01739d8f2167e05b11ba9d9d31853b7
  -- Baker, Harman and Pintz (2001): for large k the interval (k, k + k^(21/40)) holds at
  -- least C k^(21/40) / log k primes. Stated exactly as `axiom bhp` in van Doorn and Tang's
  -- formalisation (github.com/Woett/ChatGPT-s-note-on-Erdos451), with `primeCard` unfolded.
  have h_bhp : ∃ C : ℝ, 0 < C ∧ ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k →
      C * (k : ℝ) ^ ((21 : ℝ) / 40) / Real.log k ≤
        (((Finset.Ioo ⌊(k : ℝ)⌋ ⌈(k : ℝ) + (k : ℝ) ^ ((21 : ℝ) / 40)⌉).filter
          (fun p : ℤ => 0 < p ∧ p.natAbs.Prime ∧ (k : ℝ) < (p : ℝ) ∧
            (p : ℝ) < (k : ℝ) + (k : ℝ) ^ ((21 : ℝ) / 40))).card : ℝ) := by
    sorry
  -- van Doorn and Tang, arXiv:2606.19863, Theorem 1.1 (`main_theorem` of their Lean file,
  -- proved there from `bhp` alone, Konyagin's fractional-parts theorem included): for large k
  -- and 2k < n ≤ exp(log² k / (20 log log k)), some prime p in (k, k + 3 k^(21/40)) divides
  -- (n - k)(n - k + 1)⋯(n - 1). Stated as "BHP fails, or the theorem holds", so that the hole
  -- is exactly what their file proves.
  have h_vdt : (¬ ∃ C : ℝ, 0 < C ∧ ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k →
        C * (k : ℝ) ^ ((21 : ℝ) / 40) / Real.log k ≤
          (((Finset.Ioo ⌊(k : ℝ)⌋ ⌈(k : ℝ) + (k : ℝ) ^ ((21 : ℝ) / 40)⌉).filter
            (fun p : ℤ => 0 < p ∧ p.natAbs.Prime ∧ (k : ℝ) < (p : ℝ) ∧
              (p : ℝ) < (k : ℝ) + (k : ℝ) ^ ((21 : ℝ) / 40))).card : ℝ)) ∨
      ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k → ∀ n : ℤ, 2 * (k : ℤ) < n →
        (n : ℝ) ≤ Real.exp (Real.log k ^ 2 / (20 * Real.log (Real.log k))) →
        ∃ p : ℕ, p.Prime ∧ (k : ℝ) < p ∧ (p : ℝ) < (k : ℝ) + 3 * (k : ℝ) ^ ((21 : ℝ) / 40) ∧
          (p : ℤ) ∣ ∏ i ∈ Finset.Icc 1 k, (n - (i : ℤ)) := by
    sorry
  -- What remains of this range: a thin strip above k², where the prime van Doorn and Tang
  -- give may exceed ⌊n/k⌋. The assembly hands over k ⌊n/k⌋ ∣ k! as on erdos-1094--h2--h2.
  have h_strip : ∃ K : ℕ, ∀ n k : ℕ, 0 < k → k * k ≤ n →
      (n : ℝ) < k * (k + 3 * (k : ℝ) ^ ((21 : ℝ) / 40)) →
      k * (n / k) ∣ k ! → (n.choose k).minFac > n / k → k ≤ K := by
    sorry
  -- the assembly
  obtain ⟨k₀, hk₀⟩ := h_vdt.resolve_left (not_not.mpr h_bhp)
  obtain ⟨K, hK⟩ := h_strip
  -- k³ ≤ exp(log² k / (20 log log k)) for large k, so n < k³ is inside van Doorn and Tang's range
  have hasym : ∃ k₁ : ℕ, ∀ k : ℕ, k₁ ≤ k →
      (k : ℝ) ^ 3 ≤ Real.exp (Real.log k ^ 2 / (20 * Real.log (Real.log k))) := by
    have hev : ∀ᶠ y : ℝ in Filter.atTop, Real.log y ≤ y / 120 := by
      filter_upwards [Real.isLittleO_log_id_atTop.bound (show (0 : ℝ) < 1 / 120 by norm_num),
        Filter.eventually_ge_atTop (1 : ℝ)] with y hy hy1
      rw [Real.norm_eq_abs, Real.norm_eq_abs, id, abs_of_nonneg (Real.log_nonneg hy1),
        abs_of_nonneg (show (0 : ℝ) ≤ y by linarith)] at hy
      linarith
    obtain ⟨Y, hY⟩ := Filter.eventually_atTop.1 hev
    refine ⟨⌈Real.exp (max Y 3)⌉₊, fun k hk => ?_⟩
    have hkpos : (0 : ℝ) < k := by
      have := Nat.le_of_ceil_le hk
      linarith [Real.exp_pos (max Y 3)]
    have hL : max Y 3 ≤ Real.log k := by
      rw [Real.le_log_iff_exp_le hkpos]
      exact Nat.le_of_ceil_le hk
    set L := Real.log k with hLdef
    have hL3 : 3 ≤ L := le_trans (le_max_right _ _) hL
    have hLL : 0 < Real.log L := Real.log_pos (by linarith)
    have hLLb : Real.log L ≤ L / 120 := hY L (le_trans (le_max_left _ _) hL)
    have key : 3 * L ≤ L ^ 2 / (20 * Real.log L) := by
      rw [le_div_iff₀ (by positivity)]
      nlinarith
    calc (k : ℝ) ^ 3 = Real.exp (3 * L) := by
          rw [hLdef, ← Real.log_rpow hkpos, Real.exp_log (by positivity)]; norm_num
      _ ≤ _ := Real.exp_le_exp.mpr key
  obtain ⟨k₁, hk₁⟩ := hasym
  refine ⟨max (max k₀ K) (max k₁ 4), fun n k hk hkn hcube hmin => ?_⟩
  by_contra hcon
  have hlt := not_le.mp hcon
  have hkK : K < k := lt_of_le_of_lt (le_trans (le_max_right _ _) (le_max_left _ _)) hlt
  have hk0 : k₀ ≤ k := le_of_lt (lt_of_le_of_lt (le_trans (le_max_left _ _) (le_max_left _ _)) hlt)
  have hk1 : k₁ ≤ k := le_of_lt (lt_of_le_of_lt (le_trans (le_max_left _ _) (le_max_right _ _)) hlt)
  have hk4 : 4 < k := lt_of_le_of_lt (le_trans (le_max_right _ _) (le_max_right _ _)) hlt
  have hkk : k ≤ n / k := (Nat.le_div_iff_mul_le hk).2 hkn
  -- no prime p ≤ n / k divides C(n, k)
  have hnd : ∀ p : ℕ, p.Prime → p ≤ n / k → ¬ p ∣ n.choose k := by
    intro p hp hpt hpd
    have := Nat.minFac_le_of_dvd hp.two_le hpd
    omega
  -- k ⌊n/k⌋ divides k! (as in the proof of erdos-1094--h1)
  have htop : k * (n / k) ∣ k ! := by
    have htpos : 0 < n / k := lt_of_lt_of_le hk hkk
    have hm_le : k * (n / k) ≤ n := Nat.mul_div_le n k
    have hm_gt : n < k * (n / k) + k := by
      have := Nat.lt_mul_div_succ n hk
      linarith [this]
    have hcop : Nat.Coprime (k * (n / k)) (n.choose k) := by
      apply Nat.coprime_of_dvd
      intro p hp hpm hpC
      rcases (Nat.Prime.dvd_mul hp).1 hpm with h | h
      · exact hnd p hp (le_trans (Nat.le_of_dvd hk h) hkk) hpC
      · exact hnd p hp (Nat.le_of_dvd htpos h) hpC
    have hm_dvd : k * (n / k) ∣ k ! * n.choose k := by
      rw [← Nat.descFactorial_eq_factorial_mul_choose, Nat.descFactorial_eq_prod_range]
      have hj : n - k * (n / k) ∈ Finset.range k := Finset.mem_range.2 (by omega)
      have h1 := Finset.dvd_prod_of_mem (fun i => n - i) hj
      have h2 : n - (n - k * (n / k)) = k * (n / k) := by omega
      simpa only [h2] using h1
    exact hcop.dvd_of_dvd_mul_right hm_dvd
  by_cases hstrip : (n : ℝ) < k * (k + 3 * (k : ℝ) ^ ((21 : ℝ) / 40))
  · exact absurd (hK n k hk hkn hstrip htop hmin) (not_le.mpr hkK)
  · -- above the strip: a prime in (k, k + 3 k^(21/40)) divides the window and is ≤ ⌊n/k⌋
    have hstrip := not_lt.mp hstrip
    have h2k : 2 * (k : ℤ) < (n : ℤ) + 1 := by
      have : 2 * k < n + 1 := by nlinarith
      exact_mod_cast this
    have hexp : (((n : ℤ) + 1 : ℤ) : ℝ) ≤ Real.exp (Real.log k ^ 2 / (20 * Real.log (Real.log k))) := by
      have hn1 : n + 1 ≤ k * k * k := hcube
      have : ((n : ℝ) + 1) ≤ (k : ℝ) ^ 3 := by
        have : ((n + 1 : ℕ) : ℝ) ≤ ((k * k * k : ℕ) : ℝ) := by exact_mod_cast hn1
        push_cast at this
        nlinarith
      push_cast
      exact le_trans this (hk₁ k hk1)
    obtain ⟨p, hp, hkp, hpb, hpdvd⟩ := hk₀ k hk0 ((n : ℤ) + 1) h2k hexp
    -- the window product is n.descFactorial k
    have hprod : ∀ j : ℕ, j ≤ n →
        ∏ i ∈ Finset.Icc 1 j, (((n : ℤ) + 1) - (i : ℤ)) = ((n.descFactorial j : ℕ) : ℤ) := by
      intro j
      induction j with
      | zero => intro _; simp
      | succ j ih =>
        intro hj
        rw [Finset.prod_Icc_succ_top (by omega), ih (by omega), Nat.descFactorial_succ]
        push_cast [Nat.cast_sub (show j ≤ n by omega)]
        ring
    rw [hprod k (by nlinarith)] at hpdvd
    have hpd : p ∣ k ! * n.choose k := by
      rw [← Nat.descFactorial_eq_factorial_mul_choose]
      exact_mod_cast hpdvd
    have hkp' : k < p := by exact_mod_cast hkp
    have hpC : p ∣ n.choose k := by
      rcases (Nat.Prime.dvd_mul hp).1 hpd with h | h
      · exact absurd ((Nat.Prime.dvd_factorial hp).1 h) (not_le.mpr hkp')
      · exact h
    have hpk : p * k ≤ n := by
      have hkpos : (0 : ℝ) < k := by exact_mod_cast hk
      have : (p : ℝ) * k < n := by nlinarith
      exact_mod_cast this.le
    exact hnd p hp ((Nat.le_div_iff_mul_le hk).2 hpk) hpC
