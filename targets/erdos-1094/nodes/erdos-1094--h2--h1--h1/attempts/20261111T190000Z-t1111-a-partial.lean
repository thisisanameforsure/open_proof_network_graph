private theorem med_tendsto (b c : ℝ) (hc : 0 < c) :
    Filter.Tendsto (fun x : ℝ => (Real.log x) ^ b * x ^ (-c)) Filter.atTop (nhds 0) := by
  have h_log : (fun x : ℝ => Real.log x ^ b) =o[Filter.atTop] (fun x : ℝ => x ^ c) :=
    isLittleO_log_rpow_rpow_atTop b hc
  convert h_log.tendsto_div_nhds_zero.congr' _ using 1;
  filter_upwards [ Filter.eventually_gt_atTop 0 ] with x hx using by rw [ div_eq_mul_inv, Real.rpow_neg hx.le ] ;

private theorem med_poly_log_lt (A α β tt : ℝ) (hα : α < tt) (C : ℝ) (hC : 0 < C) :
    ∀ᶠ k : ℕ in Filter.atTop,
      A * (k : ℝ) ^ α * (Real.log k) ^ β ≤ C * (k : ℝ) ^ tt / Real.log k := by
  have h_lim : Filter.Tendsto (fun k : ℕ => (A * (k : ℝ) ^ α * (Real.log k) ^ β) / ((k : ℝ) ^ tt / (Real.log k))) Filter.atTop (nhds 0) := by
    suffices h_simp : Filter.Tendsto (fun k : ℕ => A * (Real.log k) ^ (β + 1) * (k : ℝ) ^ (α - tt)) Filter.atTop (nhds 0) by
      refine h_simp.congr' ?_;
      filter_upwards [ Filter.eventually_gt_atTop 1 ] with k hk ; rw [ Real.rpow_sub ( by positivity ) ] ; ring_nf;
      rw [ Real.rpow_add ( Real.log_pos ( Nat.one_lt_cast.mpr hk ) ), Real.rpow_one ] ; norm_num ; ring;
    have := med_tendsto ( β + 1 ) ( tt - α ) ?_;
    · convert this.const_mul A |> Filter.Tendsto.comp <| tendsto_natCast_atTop_atTop using 2 <;> norm_num ; ring;
    · linarith;
  filter_upwards [ h_lim.eventually ( gt_mem_nhds hC ), Filter.eventually_gt_atTop 1 ] with k hk₁ hk₂;
  rw [ div_lt_iff₀ ( div_pos ( Real.rpow_pos_of_pos ( Nat.cast_pos.mpr hk₂.le ) _ ) ( Real.log_pos ( Nat.one_lt_cast.mpr hk₂ ) ) ) ] at hk₁ ; ring_nf at hk₁ ⊢ ; linarith

private theorem med_poly_log_lt_eq (A tt : ℝ) (C : ℝ) (hC : 0 < C) :
    ∀ᶠ k : ℕ in Filter.atTop,
      A * (k : ℝ) ^ tt * (Real.log k) ^ (-(2 : ℝ)) ≤ C * (k : ℝ) ^ tt / Real.log k := by
  have h_log_bound : ∀ᶠ k : ℕ in Filter.atTop, A ≤ C * Real.log k := by
    exact Filter.eventually_atTop.mpr ⟨ ⌈Real.exp ( A / C ) ⌉₊ + 1, fun k hk => by nlinarith [ Nat.le_ceil ( Real.exp ( A / C ) ), Real.log_exp ( A / C ), Real.log_le_log ( by positivity ) ( show ( k :ℝ ) ≥ Real.exp ( A / C ) by exact le_of_lt ( Nat.lt_of_ceil_lt hk ) ), mul_div_cancel₀ A hC.ne' ] ⟩;
  filter_upwards [ h_log_bound, Filter.eventually_gt_atTop 1 ] with k hk₁ hk₂;
  have hl : 0 < Real.log k := Real.log_pos (by exact_mod_cast hk₂)
  have hp : 0 ≤ (k:ℝ)^tt := Real.rpow_nonneg (Nat.cast_nonneg _) _
  rw [Real.rpow_neg hl.le, Real.rpow_two]
  have e : A * (k:ℝ)^tt * (Real.log k ^ 2)⁻¹ = A * (k:ℝ)^tt / Real.log k / Real.log k := by
    field_simp
  rw [e, div_le_div_iff_of_pos_right hl, div_le_iff₀ hl]
  nlinarith [mul_le_mul_of_nonneg_right hk₁ hp]

private theorem med_rhs_le_gen (θ : ℝ) (hθ0 : 0 < θ) (hθ1 : θ < 1) (C : ℝ) (hC : 0 < C) :
    ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k →
      (3 : ℝ) + 56 * (k : ℝ) ^ (2 * θ - 1) + (k : ℝ) ^ θ * Real.log (k : ℝ) ^ (-2 : ℝ) ≤
        C * (k : ℝ) ^ θ / Real.log (k : ℝ) := by
  have h1 : ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k → 3 ≤ (C / 3) * (k : ℝ) ^ θ / Real.log k := by
    have := med_poly_log_lt 3 0 0 θ hθ0 ( C / 3 ) ( by linarith ) ; aesop;
  have h2 : ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k → 56 * (k : ℝ) ^ (2 * θ - 1) ≤ (C / 3) * (k : ℝ) ^ θ / Real.log k := by
    convert med_poly_log_lt 56 ( 2 * θ - 1 ) 0 θ ( by linarith ) ( C / 3 ) ( by linarith ) using 1;
    norm_num [ Filter.eventually_atTop ]
  have h3 : ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k → (k : ℝ) ^ θ * (Real.log k) ^ (-(2 : ℝ)) ≤ (C / 3) * (k : ℝ) ^ θ / Real.log k := by
    convert med_poly_log_lt_eq 1 θ ( C / 3 ) ( by linarith ) using 1;
    norm_num [ Filter.eventually_atTop ];
  obtain ⟨a1, h1'⟩ := h1
  obtain ⟨a2, h2'⟩ := h2
  obtain ⟨a3, h3'⟩ := h3
  refine ⟨max a1 (max a2 a3), fun k hk => ?_⟩
  have x1 := h1' k (le_trans (le_max_left _ _) hk)
  have x2 := h2' k (le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hk)
  have x3 := h3' k (le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hk)
  have e : C * (k:ℝ) ^ θ / Real.log k = 3 * (C / 3 * (k:ℝ) ^ θ / Real.log k) := by ring
  linarith

private lemma med_rhs_le (C : ℝ) (hC : 0 < C) : ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k →
    (3:ℝ) + 56 * (k:ℝ)^(2*(21/40:ℝ) - 1) + (k:ℝ)^(21/40:ℝ) * Real.log (k:ℝ) ^ (-2:ℝ) ≤ C * (k:ℝ)^(21/40:ℝ) / Real.log (k:ℝ) :=
  med_rhs_le_gen (21/40) (by norm_num) (by norm_num) C hC

private lemma G_carry_dvd (n k p : ℕ) (hp : p.Prime) (hk : k < 2 * p) (h : n % p + p < k) :
    p ∣ n.choose k := by
  have hfact : Fact p.Prime := ⟨hp⟩
  have hkp : k % p = k - p := by
    rw [Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt (by omega)]
  have hzero : (n % p).choose (k % p) = 0 := Nat.choose_eq_zero_of_lt (by omega)
  have hmodeq := Choose.choose_modEq_choose_mod_mul_choose_div_nat (n := n) (k := k) (p := p)
  rw [hzero, zero_mul] at hmodeq
  exact (Nat.modEq_zero_iff_dvd).1 hmodeq

private lemma G_shift (K k n p : ℕ) (N : ℤ) (hK1 : 1 ≤ K) (hk1 : 2 * K ≤ k)
    (hN : N = (n : ℤ) - (k : ℤ) - ⌊(K : ℝ) ^ (21 / 40 : ℝ)⌋)
    (hp : (K : ℝ) < (p : ℝ)) (hpK : (p : ℝ) < (K : ℝ) + (K : ℝ) ^ (21 / 40 : ℝ))
    (hbad : k ≤ n % p + p) :
    |(N : ℝ) / (p : ℝ) - (round ((N : ℝ) / (p : ℝ)) : ℝ)| <
      (1 : ℝ) / (K : ℝ) ^ ((1 : ℝ) - (21 / 40 : ℝ)) := by
  have hK0 : (0 : ℝ) < K := by exact_mod_cast hK1
  have hx0 : 0 < (K : ℝ) ^ (21 / 40 : ℝ) := Real.rpow_pos_of_pos hK0 _
  generalize hx : (K : ℝ) ^ (21 / 40 : ℝ) = x at hN hpK hx0
  generalize hs : ⌊x⌋ = s at hN
  have hsx : (s : ℝ) ≤ x := by rw [← hs]; exact Int.floor_le x
  have hKp : K + 1 ≤ p := by exact_mod_cast hp
  have hts : (p : ℤ) - (K : ℤ) ≤ s := by
    have h1 : (((p : ℤ) - (K : ℤ) : ℤ) : ℝ) < x := by push_cast; linarith
    have h2 : (p : ℤ) - (K : ℤ) < ⌈x⌉ := Int.lt_ceil.mpr h1
    have h3 := Int.ceil_le_floor_add_one x
    omega
  have hp0 : 0 < p := by omega
  have hr : n % p < p := Nat.mod_lt _ hp0
  have hdiv : p * (n / p) + n % p = n := Nat.div_add_mod n p
  have hdivZ : (n : ℤ) = (p : ℤ) * ((n / p : ℕ) : ℤ) + ((n % p : ℕ) : ℤ) := by exact_mod_cast hdiv.symm
  generalize hq : ((n / p : ℕ) : ℤ) = q at hdivZ
  have hrZ : ((n % p : ℕ) : ℤ) < (p : ℤ) := by exact_mod_cast hr
  have hbadZ : (k : ℤ) ≤ ((n % p : ℕ) : ℤ) + (p : ℤ) := by exact_mod_cast hbad
  generalize hr' : ((n % p : ℕ) : ℤ) = r at hdivZ hrZ hbadZ
  have hk1Z : 2 * (K : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk1
  have hNe : N = (q - 1) * (p : ℤ) + (r + (p : ℤ) - (k : ℤ) - s) := by
    rw [hN, hdivZ]; ring
  have he1 : -s ≤ r + (p : ℤ) - (k : ℤ) - s := by linarith
  have he2 : r + (p : ℤ) - (k : ℤ) - s ≤ s := by linarith
  generalize he : r + (p : ℤ) - (k : ℤ) - s = e at hNe he1 he2
  have habs : |(e : ℝ)| ≤ x := by
    rw [abs_le]; constructor
    · have : ((-s : ℤ) : ℝ) ≤ (e : ℝ) := by exact_mod_cast he1
      push_cast at this; linarith
    · have : (e : ℝ) ≤ (s : ℝ) := by exact_mod_cast he2
      linarith
  have hpR : (0 : ℝ) < (p : ℝ) := by exact_mod_cast hp0
  have key : (N : ℝ) / (p : ℝ) - ((q - 1 : ℤ) : ℝ) = (e : ℝ) / (p : ℝ) := by
    rw [hNe]; push_cast; field_simp; ring
  have hfin : x / (K : ℝ) = (1 : ℝ) / (K : ℝ) ^ ((1 : ℝ) - (21 / 40 : ℝ)) := by
    rw [Real.rpow_sub hK0, Real.rpow_one, hx]; field_simp
  calc |(N : ℝ) / (p : ℝ) - (round ((N : ℝ) / (p : ℝ)) : ℝ)|
      ≤ |(N : ℝ) / (p : ℝ) - ((q - 1 : ℤ) : ℝ)| := round_le _ _
    _ = |(e : ℝ)| / (p : ℝ) := by rw [key, abs_div, abs_of_pos hpR]
    _ ≤ x / (p : ℝ) := by gcongr
    _ < x / (K : ℝ) := div_lt_div_of_pos_left hx0 hK0 hp
    _ = _ := hfin

private lemma G_exists_prime (K : ℕ) (N : ℤ)
    (hcount : (↑{m ∈ Finset.Ioo (↑K : ℤ) ((↑K : ℤ) + ⌊(↑K : ℝ) ^ (21 / 40 : ℝ)⌋ + (2 : ℤ)) |
          (↑K : ℤ) < m ∧ (↑m : ℝ) < (↑K : ℝ) + (↑K : ℝ) ^ (21 / 40 : ℝ) ∧
            |(↑N : ℝ) / (↑m : ℝ) - (↑(round ((↑N : ℝ) / (↑m : ℝ))) : ℝ)| <
              (1 : ℝ) / (↑K : ℝ) ^ ((1 : ℝ) - (21 / 40 : ℝ))}.card : ℝ) <
      (↑{p ∈ Finset.Ioo ⌊(↑K : ℝ)⌋ ⌈(↑K : ℝ) + (↑K : ℝ) ^ (21 / 40 : ℝ)⌉ |
          (0 : ℤ) < p ∧ Nat.Prime p.natAbs ∧ (↑K : ℝ) < (↑p : ℝ) ∧ (↑p : ℝ) < (↑K : ℝ) + (↑K : ℝ) ^ (21 / 40 : ℝ)}.card : ℝ)) :
    ∃ p : ℕ, p.Prime ∧ (K : ℝ) < (p : ℝ) ∧ (p : ℝ) < (K : ℝ) + (K : ℝ) ^ (21 / 40 : ℝ) ∧
      ¬ |(N : ℝ) / (p : ℝ) - (round ((N : ℝ) / (p : ℝ)) : ℝ)| <
        (1 : ℝ) / (K : ℝ) ^ ((1 : ℝ) - (21 / 40 : ℝ)) := by
  by_contra hcon
  push Not at hcon
  have hsub : {p ∈ Finset.Ioo ⌊(↑K : ℝ)⌋ ⌈(↑K : ℝ) + (↑K : ℝ) ^ (21 / 40 : ℝ)⌉ |
          (0 : ℤ) < p ∧ Nat.Prime p.natAbs ∧ (↑K : ℝ) < (↑p : ℝ) ∧ (↑p : ℝ) < (↑K : ℝ) + (↑K : ℝ) ^ (21 / 40 : ℝ)} ⊆
      {m ∈ Finset.Ioo (↑K : ℤ) ((↑K : ℤ) + ⌊(↑K : ℝ) ^ (21 / 40 : ℝ)⌋ + (2 : ℤ)) |
          (↑K : ℤ) < m ∧ (↑m : ℝ) < (↑K : ℝ) + (↑K : ℝ) ^ (21 / 40 : ℝ) ∧
            |(↑N : ℝ) / (↑m : ℝ) - (↑(round ((↑N : ℝ) / (↑m : ℝ))) : ℝ)| <
              (1 : ℝ) / (↑K : ℝ) ^ ((1 : ℝ) - (21 / 40 : ℝ))} := by
    intro z hz
    simp only [Finset.mem_filter, Finset.mem_Ioo] at hz ⊢
    obtain ⟨_, hz0, hzp, hz1, hz2⟩ := hz
    have hzc : ((z.natAbs : ℕ) : ℝ) = (z : ℝ) := by
      rw [Nat.cast_natAbs, abs_of_pos hz0]
    have hKz : (K : ℤ) < z := by exact_mod_cast hz1
    refine ⟨⟨hKz, ?_⟩, hKz, hz2, ?_⟩
    · have h2 := Int.lt_floor_add_one ((K : ℝ) ^ (21 / 40 : ℝ))
      have h3 : (z : ℝ) < (((K : ℤ) + ⌊(K : ℝ) ^ (21 / 40 : ℝ)⌋ + 1 : ℤ) : ℝ) := by push_cast; linarith
      have h4 : z < (K : ℤ) + ⌊(K : ℝ) ^ (21 / 40 : ℝ)⌋ + 1 := by exact_mod_cast h3
      linarith
    · have h5 := hcon z.natAbs hzp (by rw [hzc]; exact hz1) (by rw [hzc]; exact hz2)
      rwa [hzc] at h5
  have hle := Finset.card_le_card hsub
  have hle' := (Nat.cast_le (α := ℝ)).mpr hle
  linarith

private lemma G_main (C : ℝ) (K k n : ℕ) (N : ℤ) (hK1 : 1 ≤ K) (hk1 : 2 * K ≤ k) (hk2 : k ≤ 2 * K + 1)
    (hN : N = (n : ℤ) - (k : ℤ) - ⌊(K : ℝ) ^ (21 / 40 : ℝ)⌋)
    (hbhp : C * (↑K : ℝ) ^ (21 / 40 : ℝ) / Real.log (↑K : ℝ) ≤
      (↑{p ∈ Finset.Ioo ⌊(↑K : ℝ)⌋ ⌈(↑K : ℝ) + (↑K : ℝ) ^ (21 / 40 : ℝ)⌉ |
          (0 : ℤ) < p ∧ Nat.Prime p.natAbs ∧ (↑K : ℝ) < (↑p : ℝ) ∧ (↑p : ℝ) < (↑K : ℝ) + (↑K : ℝ) ^ (21 / 40 : ℝ)}.card : ℝ))
    (hcard : (↑{m ∈ Finset.Ioo (↑K : ℤ) ((↑K : ℤ) + ⌊(↑K : ℝ) ^ (21 / 40 : ℝ)⌋ + (2 : ℤ)) |
          (↑K : ℤ) < m ∧ (↑m : ℝ) < (↑K : ℝ) + (↑K : ℝ) ^ (21 / 40 : ℝ) ∧
            |(↑N : ℝ) / (↑m : ℝ) - (↑(round ((↑N : ℝ) / (↑m : ℝ))) : ℝ)| <
              (1 : ℝ) / (↑K : ℝ) ^ ((1 : ℝ) - (21 / 40 : ℝ))}.card : ℝ) < C * (↑K : ℝ) ^ (21 / 40 : ℝ) / Real.log (↑K : ℝ)) :
    ∃ p : ℕ, p.Prime ∧ k < 2 * p ∧ n % p + p < k := by
  obtain ⟨p, hp, hKp, hpK, hfar⟩ := G_exists_prime K N (lt_of_lt_of_le hcard hbhp)
  have hKp' : K + 1 ≤ p := by exact_mod_cast hKp
  refine ⟨p, hp, by omega, ?_⟩
  by_contra hbad
  exact hfar (G_shift K k n p N hK1 hk1 hN hKp hpK (by omega))

private lemma G_exp_bound : ∃ ke : ℕ, ∀ K : ℕ, ke ≤ K →
    ((2 : ℝ) * (K : ℝ) + 2) ^ 3 ≤
      Real.exp (Real.log (↑K : ℝ) ^ (2 : ℕ) / ((20 : ℝ) * Real.log (Real.log (↑K : ℝ)))) := by
  have hlo : ∀ᶠ y : ℝ in Filter.atTop, ‖Real.log y‖ ≤ (1 / 120 : ℝ) * ‖y‖ :=
    Real.isLittleO_log_id_atTop.bound (by norm_num)
  obtain ⟨y₀, hy₀⟩ := Filter.eventually_atTop.mp hlo
  refine ⟨⌈Real.exp (max y₀ 2)⌉₊ + 4, fun K hK => ?_⟩
  have hK4 : (4 : ℝ) ≤ (K : ℝ) := by exact_mod_cast (by omega : 4 ≤ K)
  have hK0 : (0 : ℝ) < (K : ℝ) := by linarith
  have hexp : Real.exp (max y₀ 2) ≤ (K : ℝ) := by
    have h1 := Nat.le_ceil (Real.exp (max y₀ 2))
    have h2 : ((⌈Real.exp (max y₀ 2)⌉₊ : ℕ) : ℝ) ≤ (K : ℝ) := by exact_mod_cast (by omega : ⌈Real.exp (max y₀ 2)⌉₊ ≤ K)
    linarith
  have hL : max y₀ 2 ≤ Real.log (K : ℝ) := (Real.le_log_iff_exp_le hK0).mpr hexp
  generalize hLd : Real.log (K : ℝ) = L at hL
  have hL2 : (2 : ℝ) ≤ L := le_trans (le_max_right _ _) hL
  have hLy : y₀ ≤ L := le_trans (le_max_left _ _) hL
  have hlogL : 0 < Real.log L := Real.log_pos (by linarith)
  have h120 : 120 * Real.log L ≤ L := by
    have h := hy₀ L hLy
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos hlogL, abs_of_pos (by linarith : (0 : ℝ) < L)] at h
    linarith
  have h6 : 6 * L ≤ L ^ (2 : ℕ) / ((20 : ℝ) * Real.log L) := by
    rw [le_div_iff₀ (by positivity)]
    nlinarith [mul_le_mul_of_nonneg_left h120 (by linarith : (0 : ℝ) ≤ L)]
  have hK6 : ((2 : ℝ) * (K : ℝ) + 2) ^ 3 ≤ Real.exp (6 * L) := by
    have h1 : (2 : ℝ) * (K : ℝ) + 2 ≤ (K : ℝ) ^ 2 := by nlinarith
    have h2 : ((2 : ℝ) * (K : ℝ) + 2) ^ 3 ≤ ((K : ℝ) ^ 2) ^ 3 := by
      apply pow_le_pow_left₀ (by positivity) h1
    have h3 : Real.exp (6 * L) = (K : ℝ) ^ 6 := by
      rw [← hLd, show (6 : ℝ) * Real.log (K : ℝ) = ((6 : ℕ) : ℝ) * Real.log (K : ℝ) by norm_num,
        Real.exp_nat_mul, Real.exp_log hK0]
    rw [h3]; calc _ ≤ ((K : ℝ) ^ 2) ^ 3 := h2
      _ = (K : ℝ) ^ 6 := by ring
  exact le_trans hK6 (Real.exp_le_exp.mpr h6)

private lemma G_big (C : ℝ) (K k n : ℕ) (hK4 : 4 ≤ K) (hk1 : 2 * K ≤ k) (hk2 : k ≤ 2 * K + 1)
