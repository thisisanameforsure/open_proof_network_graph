    have h_kfull : ∃ (c : ℝ),
      (0 : ℝ) < c ∧
        ∃ (k₀ : ℕ),
          ∀ (k : ℕ),
            k₀ ≤ k →
              ∀ (n : ℕ),
                k * k * k ≤ n →
                  (↑n : ℝ) ≤ Real.exp (c * Real.log (↑k : ℝ) ^ (2 : ℕ)) →
                    ∃ (p : ℕ), Nat.Prime p ∧ p ≤ k ∧ p ∣ n.choose k := sorry
    exact h_kfull
  ·
    -- label: bounded k on n ≥ k³, n > exp(c·log²k), every c > 0
    -- claim: $\forall c > 0\ \exists K\ \forall n, k:\ 0 < k,\ k^3 \le n,\ \exp(c \log^2 k) < n,\ \operatorname{lpf}\tbinom{n}{k} > \lfloor n/k \rfloor \implies k \le K$
    -- Here $\operatorname{lpf}$ is the least prime factor (`Nat.minFac`), $n / k$ is floor division, and $\exp(c \log^2 k) < n$ is an inequality between real numbers.
    have h_edge : ∀ (c : ℝ),
      (0 : ℝ) < c →
        ∃ (K : ℕ),
          ∀ (n k : ℕ),
            (0 : ℕ) < k →
              k * k * k ≤ n →
                Real.exp (c * Real.log (↑k : ℝ) ^ (2 : ℕ)) < (↑n : ℝ) → (n.choose k).minFac > n / k → k ≤ K := sorry
