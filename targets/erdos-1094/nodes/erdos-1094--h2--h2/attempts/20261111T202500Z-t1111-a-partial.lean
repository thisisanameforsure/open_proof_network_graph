  refine KR_final ?_ ?_
  ·
    -- label: a prime ≤ k divides C(n,k), k³ ≤ n ≤ exp(c·log²k)
    -- claim: $\exists c > 0\ \exists k_0\ \forall k \ge k_0\ \forall n,\ k^3 \le n \le \exp(c \log^2 k):\ \exists p \text{ prime},\ p \le k,\ p \mid \tbinom{n}{k}$
