                Real.exp (c * Real.log (↑k : ℝ) ^ (2 : ℕ)) < (↑n : ℝ) → (n.choose k).minFac > n / k → k ≤ K) :
    ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → k * k * k ≤ n → (n.choose k).minFac > n / k → k ≤ K := by
  obtain ⟨c, hc, k₀, hk⟩ := h_kfull
  obtain ⟨K, hK⟩ := h_edge c hc
  refine ⟨max k₀ K, fun n k hk0 hn hmin => ?_⟩
  by_contra hcon
  have hk₀ : k₀ ≤ k := by omega
  have hKk : K < k := by omega
  by_cases hle : (↑n : ℝ) ≤ Real.exp (c * Real.log (↑k : ℝ) ^ (2 : ℕ))
  · obtain ⟨p, hp, hpk, hdvd⟩ := hk k hk₀ n hn hle
    have hle' : (n.choose k).minFac ≤ p := Nat.minFac_le_of_dvd hp.two_le hdvd
    have hkk : k * k ≤ n := le_trans (Nat.le_mul_of_pos_right (k * k) hk0) hn
    have hkd : k ≤ n / k := (Nat.le_div_iff_mul_le hk0).2 hkk
    omega
  · exact absurd (hK n k hk0 hn (lt_of_not_ge hle) hmin) (by omega)

theorem erdos_1094__h2__h2 : ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → k * k * k ≤ n → (n.choose k).minFac > n / k → k ≤ K := by
  -- approach: Split n ≥ k³ at n = exp(c·log²k). Below it a prime p ≤ k divides C(n,k) (Konyagin's range, to be proved from the primes q·p just above k with q ≤ k^ε), and p ≤ k ≤ n/k. Above it is the open problem. The constant c is the first hole's.
