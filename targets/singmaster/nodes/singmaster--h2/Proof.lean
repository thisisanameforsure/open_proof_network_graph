open Singmaster

/-! Hole `h2` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

private theorem sm_le_choose : ∀ n k : ℕ, 1 ≤ k → k < n → n ≤ Nat.choose n k := by
  intro n
  induction n with
  | zero => intro k _ h; omega
  | succ m ih =>
    intro k hk hkn
    rcases Nat.lt_or_ge k 2 with h | h
    · have hk1 : k = 1 := by omega
      subst hk1
      simp
    · obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      rw [Nat.choose_succ_succ']
      rcases Nat.lt_or_ge (j + 1) m with h2 | h2
      · have a := ih (j + 1) (by omega) h2
        have b : 0 < Nat.choose m j := Nat.choose_pos (by omega)
        omega
      · have hjm : j + 1 = m := by omega
        have a := ih j (by omega) (by omega)
        have b : Nat.choose m (j + 1) = 1 := by rw [hjm, Nat.choose_self]
        omega

private theorem sm_fin (t : ℕ) : (Singmaster.solutions t).Finite := by
  apply Set.Finite.subset (Finset.finite_toSet (Finset.range (t + 1) ×ˢ Finset.range (t + 1)))
  rintro ⟨n, k⟩ h
  simp only [Singmaster.solutions, Set.mem_setOf_eq] at h
  obtain ⟨hk, hkn, hc⟩ := h
  have := sm_le_choose n k hk hkn
  simp only [Finset.coe_product, Finset.coe_range, Set.mem_prod, Set.mem_Iio]
  omega

private theorem sm_red (t C : ℕ)
    (hS : ({p : ℕ × ℕ | 2 ≤ p.2 ∧ 2 * p.2 ≤ p.1 ∧ Nat.choose p.1 p.2 = t}).ncard ≤ C) :
    (Singmaster.solutions t).ncard ≤ 2 * C + 2 := by
  set S : Set (ℕ × ℕ) := {p : ℕ × ℕ | 2 ≤ p.2 ∧ 2 * p.2 ≤ p.1 ∧ Nat.choose p.1 p.2 = t} with hSdef
  have hSsub : S ⊆ Singmaster.solutions t := by
    rintro ⟨n, k⟩ ⟨h1, h2, h3⟩
    simp only [Singmaster.solutions, Set.mem_setOf_eq]
    exact ⟨by omega, by simp at h1 h2; omega, h3⟩
  have hSfin : S.Finite := (sm_fin t).subset hSsub
  have hsub : Singmaster.solutions t ⊆
      (({(t, 1), (t, t - 1)} : Set (ℕ × ℕ)) ∪ S) ∪ (fun p : ℕ × ℕ => (p.1, p.1 - p.2)) '' S := by
    rintro ⟨n, k⟩ h
    simp only [Singmaster.solutions, Set.mem_setOf_eq] at h
    obtain ⟨hk, hkn, hc⟩ := h
    by_cases e1 : k = 1
    · subst e1
      simp at hc
      left; left; simp [hc]
    by_cases e2 : k = n - 1
    · have : Nat.choose n k = n := by
        rw [e2, Nat.choose_symm (by omega : 1 ≤ n)]
        simp
      left; left
      right
      simp only [Set.mem_singleton_iff, Prod.mk.injEq]
      omega
    by_cases e3 : 2 * k ≤ n
    · left; right
      exact ⟨by simp; omega, by simpa using e3, hc⟩
    · right
      refine ⟨(n, n - k), ⟨by simp; omega, by simp; omega, ?_⟩, ?_⟩
      · simp only
        rw [Nat.choose_symm (by omega)]
        exact hc
      · simp only [Prod.mk.injEq, true_and]
        omega
  have hA : ({(t, 1), (t, t - 1)} : Set (ℕ × ℕ)).ncard ≤ 2 := by
    refine (Set.ncard_insert_le _ _).trans ?_
    simp
  have hU : ((({(t, 1), (t, t - 1)} : Set (ℕ × ℕ)) ∪ S) ∪
      (fun p : ℕ × ℕ => (p.1, p.1 - p.2)) '' S).Finite :=
    ((Set.toFinite _).union hSfin).union (hSfin.image _)
  calc (Singmaster.solutions t).ncard
      ≤ ((({(t, 1), (t, t - 1)} : Set (ℕ × ℕ)) ∪ S) ∪
          (fun p : ℕ × ℕ => (p.1, p.1 - p.2)) '' S).ncard := Set.ncard_le_ncard hsub hU
    _ ≤ (({(t, 1), (t, t - 1)} : Set (ℕ × ℕ)) ∪ S).ncard +
          ((fun p : ℕ × ℕ => (p.1, p.1 - p.2)) '' S).ncard := Set.ncard_union_le _ _
    _ ≤ (({(t, 1), (t, t - 1)} : Set (ℕ × ℕ)).ncard + S.ncard) + S.ncard := by
        exact Nat.add_le_add (Set.ncard_union_le _ _) (Set.ncard_image_le hSfin)
    _ ≤ 2 * C + 2 := by omega

theorem singmaster__h2 : ∀ (t C : ℕ),
  {p : ℕ × ℕ | (2 : ℕ) ≤ p.2 ∧ (2 : ℕ) * p.2 ≤ p.1 ∧ p.1.choose p.2 = t}.ncard ≤ C →
    (Singmaster.solutions t).ncard ≤ (2 : ℕ) * C + (2 : ℕ) := by
  intro t C h
  exact sm_red t C h
