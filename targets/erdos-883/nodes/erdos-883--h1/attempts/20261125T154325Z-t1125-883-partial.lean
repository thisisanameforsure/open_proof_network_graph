/-! Hole `h_long` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem erdos_883__h1 : ∀ (n : ℕ),
  ∀ A ⊆ Finset.Icc (1 : ℕ) n,
    n / (2 : ℕ) + n / (3 : ℕ) - n / (6 : ℕ) < A.card →
      ∀ (l : ℕ),
        Odd l →
          (5 : ℕ) ≤ l →
            l ≤ n / (3 : ℕ) + (1 : ℕ) → l ∈ (SimpleGraph.induce (↑A : Set ℕ) Erdos883.coprimeGraph).oddCycleLengths := by
  -- approach: reduce to arithmetic: l distinct elements of A in cyclic order, consecutive ones coprime, form a copy of cycleGraph l in G(A)
  -- licence: CC-BY-4.0
  -- label: Cyclic coprime sequence of odd length l in A
  -- claim: $|A|>\lfloor n/2\rfloor+\lfloor n/3\rfloor-\lfloor n/6\rfloor,\ l\text{ odd},\ 5\le l\le\lfloor n/3\rfloor+1\implies\exists\text{ distinct }a_0,\dots,a_{l-1}\in A\text{ with }\gcd(a_i,a_{(i+1)\bmod l})=1$
  have h_seq : ∀ (n : ℕ), ∀ A ⊆ Finset.Icc (1 : ℕ) n,
      n / (2 : ℕ) + n / (3 : ℕ) - n / (6 : ℕ) < A.card →
        ∀ (l : ℕ), Odd l → (5 : ℕ) ≤ l → l ≤ n / (3 : ℕ) + (1 : ℕ) →
          ∃ f : Fin l → ℕ, Function.Injective f ∧ (∀ i, f i ∈ A) ∧
            ∀ i j : Fin l, (SimpleGraph.cycleGraph l).Adj i j → Nat.Coprime (f i) (f j) := sorry
  -- A cyclic coprime sequence is a copy of `cycleGraph l` in `G(A)`, hence a cycle of length `l`.
  have bridge : ∀ (A : Finset ℕ) (l : ℕ), 2 < l → ∀ f : Fin l → ℕ, Function.Injective f →
      (∀ i, f i ∈ A) →
      (∀ i j : Fin l, (SimpleGraph.cycleGraph l).Adj i j → Nat.Coprime (f i) (f j)) →
      l ∈ (SimpleGraph.induce (↑A : Set ℕ) Erdos883.coprimeGraph).cycleLengths := by
    intro A l hl f hinj hA hc
    let φ : SimpleGraph.cycleGraph l →g SimpleGraph.induce (↑A : Set ℕ) Erdos883.coprimeGraph :=
      { toFun := fun i => ⟨f i, Finset.mem_coe.mpr (hA i)⟩
        map_rel' := by
          intro i j hij
          show Erdos883.coprimeGraph.Adj (f i) (f j)
          rw [Erdos883.coprimeGraph, SimpleGraph.fromRel_adj]
          exact ⟨fun h => hij.ne (hinj h), Or.inl (hc i j hij)⟩ }
    have hφ : Function.Injective φ := by
      intro i j h
      exact hinj (congrArg Subtype.val h)
    have hcopy : SimpleGraph.IsContained (SimpleGraph.cycleGraph l)
        (SimpleGraph.induce (↑A : Set ℕ) Erdos883.coprimeGraph) :=
      ⟨⟨φ, hφ⟩⟩
    obtain ⟨v, p, hp, hlen⟩ := (SimpleGraph.cycleGraph_isContained_iff hl).1 hcopy
    exact ⟨v, p, hp, hlen⟩
  intro n A hA hcard l hodd h5 hle
  obtain ⟨f, hinj, hfA, hc⟩ := h_seq n A hA hcard l hodd h5 hle
  exact ⟨bridge A l (by omega) f hinj hfA hc, hodd⟩
