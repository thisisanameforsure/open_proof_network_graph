-- hole: h_large

theorem witness : ∃ (n : ℕ) (A : Finset ℕ) (l : ℕ),
    18 ≤ n ∧ A ⊆ Finset.Icc (1 : ℕ) n ∧
      n / (2 : ℕ) + n / (3 : ℕ) - n / (6 : ℕ) < A.card ∧
        Odd l ∧ (5 : ℕ) ≤ l ∧ l ≤ n / (3 : ℕ) + (1 : ℕ) :=
  ⟨18, Finset.Icc 1 18, 7, by decide, Finset.Subset.refl _, by decide,
    ⟨3, rfl⟩, by decide, by decide⟩
