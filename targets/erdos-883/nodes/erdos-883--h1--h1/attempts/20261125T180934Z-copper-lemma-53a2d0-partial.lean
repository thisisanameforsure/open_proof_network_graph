private def avoidsVertex (v : ℕ) (c : Fin 5 → ℕ) : Bool :=
  !(List.ofFn c).contains v

/-- Every set of at most `k` deleted vertices leaves a cycle from the list.
If a deleted vertex hits the first cycle, branch on which vertex it is. -/
private def covers (k : ℕ) (cs : List (Fin 5 → ℕ)) : Bool :=
  match k, cs with
  | _, [] => false
  | 0, _ :: _ => true
  | k + 1, c :: rest =>
    (List.ofFn c).all fun v => covers k (rest.filter (avoidsVertex v))

private theorem covers_sound (k : ℕ) (cs : List (Fin 5 → ℕ)) (D : Finset ℕ)
    (hD : D.card ≤ k) (h : covers k cs = true) :
    ∃ f ∈ cs, ∀ i, f i ∉ D := by
  induction k generalizing cs D with
  | zero =>
    cases cs with
    | nil => simp [covers] at h
    | cons c cs =>
      obtain rfl := Finset.card_eq_zero.mp (Nat.le_zero.mp hD)
      exact ⟨c, List.mem_cons_self, by simp⟩
  | succ k ih =>
    cases cs with
    | nil => simp [covers] at h
    | cons c cs =>
      by_cases hit : ∃ i, c i ∈ D
      · obtain ⟨i, hi⟩ := hit
        have hcover : covers k (cs.filter (avoidsVertex (c i))) = true :=
          List.all_eq_true.mp h (c i) (List.mem_ofFn.mpr ⟨i, rfl⟩)
        have hcard : (D.erase (c i)).card ≤ k := by
          rw [Finset.card_erase_of_mem hi]
          omega
        obtain ⟨f, hf, hav⟩ := ih _ _ hcard hcover
        obtain ⟨hf, hfne⟩ := List.mem_filter.mp hf
        refine ⟨f, List.mem_cons_of_mem _ hf, fun j hj => ?_⟩
        apply hav j
        refine Finset.mem_erase.mpr ⟨?_, hj⟩
        intro heq
        have hmem : c i ∈ List.ofFn f := List.mem_ofFn.mpr ⟨j, heq⟩
        have hcontains : (List.ofFn f).contains (c i) = true := List.contains_iff_mem.mpr hmem
        simp only [avoidsVertex, hcontains, Bool.not_true, Bool.false_eq_true] at hfne
      · exact ⟨c, List.mem_cons_self, fun i hi => hit ⟨i, hi⟩⟩

private def validCycle (n : ℕ) (f : Fin 5 → ℕ) : Prop :=
  Function.Injective f ∧ (∀ i, f i ∈ Finset.Icc 1 n) ∧
    ∀ i j : Fin 5, (SimpleGraph.cycleGraph 5).Adj i j → (f i).Coprime (f j)

private def validCycleCheck (n : ℕ) (f : Fin 5 → ℕ) : Bool :=
  decide (Function.Injective f ∧ (∀ i, f i ∈ Finset.Icc 1 n) ∧
    ∀ i j : Fin 5, (SimpleGraph.cycleGraph 5).Adj i j → (f i).Coprime (f j))

private theorem validCycle_of_check (n : ℕ) (f : Fin 5 → ℕ)
    (h : validCycleCheck n f = true) : validCycle n f := by
  unfold validCycle
  exact of_decide_eq_true h

private theorem cycle_of_certificate (n k : ℕ) (A : Finset ℕ)
    (hA : A ⊆ Finset.Icc 1 n) (hcard : n ≤ A.card + k)
    (cs : List (Fin 5 → ℕ)) (hc : covers k cs = true)
    (hv : cs.all (validCycleCheck n) = true) :
    ∃ f : Fin 5 → ℕ, Function.Injective f ∧ (∀ i, f i ∈ A) ∧
      ∀ i j : Fin 5, (SimpleGraph.cycleGraph 5).Adj i j → (f i).Coprime (f j) := by
  have hD : ((Finset.Icc 1 n) \ A).card ≤ k := by
    rw [Finset.card_sdiff_of_subset hA, Nat.card_Icc]
    omega
  obtain ⟨f, hf, havoid⟩ := covers_sound k cs _ hD hc
  obtain ⟨hinj, hbound, hcop⟩ := validCycle_of_check n f (List.all_eq_true.mp hv f hf)
  refine ⟨f, hinj, fun i => ?_, hcop⟩
  by_contra h
  exact havoid i (Finset.mem_sdiff.mpr ⟨hbound i, h⟩)

/-- All longer odd-cycle obligations through size 17 reduce to a certified five-cycle. -/
private theorem erdos883_longCycle_through_seventeen (n : ℕ) (hn : n ≤ 17)
    (A : Finset ℕ) (hA : A ⊆ Finset.Icc 1 n)
    (hcard : n / 2 + n / 3 - n / 6 < A.card)
    (l : ℕ) (hlOdd : Odd l) (hlMin : 5 ≤ l) (hlMax : l ≤ n / 3 + 1) :
    ∃ f : Fin l → ℕ, Function.Injective f ∧ (∀ i, f i ∈ A) ∧
      ∀ i j : Fin l, (SimpleGraph.cycleGraph l).Adj i j → (f i).Coprime (f j) := by
  have hnMin : 12 ≤ n := by omega
  have hl : l = 5 := by
    obtain ⟨j, hj⟩ := hlOdd
    omega
  subst l
  by_cases hn12 : n = 12
  · subst n
    exact cycle_of_certificate 12 3 A hA (by omega) cycles12
      (by decide +kernel) (by decide +kernel)
  by_cases hn17 : n = 17
  · subst n
    exact cycle_of_certificate 17 5 A hA (by omega) cycles17
      (by decide +kernel) (by decide +kernel)
  let B := A.filter (fun x => x ≤ 13)
  have hB : B ⊆ Finset.Icc 1 13 := by
    intro x hx
    obtain ⟨hxA, hx13⟩ := Finset.mem_filter.mp hx
    exact Finset.mem_Icc.mpr ⟨(Finset.mem_Icc.mp (hA hxA)).1, hx13⟩
  have htail : (A.filter fun x => ¬ x ≤ 13) ⊆ Finset.Icc 14 n := by
    intro x hx
    obtain ⟨hxA, hx13⟩ := Finset.mem_filter.mp hx
    exact Finset.mem_Icc.mpr ⟨by omega, (Finset.mem_Icc.mp (hA hxA)).2⟩
  have htailCard := Finset.card_le_card htail
  rw [Nat.card_Icc] at htailCard
  have hpart := Finset.card_filter_add_card_filter_not (s := A) (p := fun x => x ≤ 13)
  change B.card + (A.filter fun x => ¬ x ≤ 13).card = A.card at hpart
  have hBcard : 13 ≤ B.card + 4 := by omega
  obtain ⟨f, hf, hmem, hcop⟩ := cycle_of_certificate 13 4 B hB hBcard cycles13
    (by decide +kernel) (by decide +kernel)
  exact ⟨f, hf, fun i => (Finset.mem_filter.mp (hmem i)).1, hcop⟩


theorem erdos_883__h1__h1 : ∀ (n : ℕ),
  ∀ A ⊆ Finset.Icc (1 : ℕ) n,
    n / (2 : ℕ) + n / (3 : ℕ) - n / (6 : ℕ) < A.card →
      ∀ (l : ℕ),
        Odd l →
          (5 : ℕ) ≤ l →
            l ≤ n / (3 : ℕ) + (1 : ℕ) →
              ∃ (f : Fin l → ℕ),
                Function.Injective f ∧
                  (∀ (i : Fin l), f i ∈ A) ∧ ∀ (i j : Fin l), (SimpleGraph.cycleGraph l).Adj i j → (f i).Coprime (f j) := by
  -- approach: Check the five-cycle range through 17 by finite certificates, leaving inputs from 18 onward.
  -- licence: Apache-2.0
  -- label: Coprime cyclic orderings from size 18
  -- claim: $\forall n\ge18,\ \forall A\subseteq[1,n],\ |A|>\lfloor n/2\rfloor+\lfloor n/3\rfloor-\lfloor n/6\rfloor\ \Rightarrow\ \forall\text{ odd }l\in[5,\lfloor n/3\rfloor+1],\ \exists\text{ an injective coprime cyclic ordering of length }l\text{ in }A$
  -- Consecutive entries, including the last and first, must be coprime.
  have h_large : ∀ (n : ℕ), 18 ≤ n →
      ∀ A ⊆ Finset.Icc (1 : ℕ) n,
        n / (2 : ℕ) + n / (3 : ℕ) - n / (6 : ℕ) < A.card →
          ∀ (l : ℕ), Odd l → (5 : ℕ) ≤ l → l ≤ n / (3 : ℕ) + (1 : ℕ) →
            ∃ (f : Fin l → ℕ), Function.Injective f ∧
              (∀ (i : Fin l), f i ∈ A) ∧
                ∀ (i j : Fin l), (SimpleGraph.cycleGraph l).Adj i j → (f i).Coprime (f j) := sorry
  intro n A hA hcard l hOdd hMin hMax
  by_cases hn : n ≤ 17
  · exact erdos883_longCycle_through_seventeen n hn A hA hcard l hOdd hMin hMax
  · exact h_large n (by omega) A hA hcard l hOdd hMin hMax
