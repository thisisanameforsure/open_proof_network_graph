/-! Hole `h_large` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

private def hasOrder (A : Finset ℕ) (l : ℕ) : Prop :=
  ∃ f : Fin l → ℕ, Function.Injective f ∧ (∀ i, f i ∈ A) ∧
    ∀ i j : Fin l, (SimpleGraph.cycleGraph l).Adj i j → (f i).Coprime (f j)

private theorem hasOrder_mono {A B : Finset ℕ} (h : A ⊆ B) {l : ℕ}
    (hA : hasOrder A l) : hasOrder B l := by
  obtain ⟨f, hf, hmem, hcop⟩ := hA
  exact ⟨f, hf, fun i => h (hmem i), hcop⟩

/-- Reduce the longer-cycle problem to the first interval in each block of six
and to the minimum-density sets that contain all four extra vertices at the end. -/
private theorem erdos883_sixBlock_reduction
    (hFirst : ∀ k : ℕ, 3 ≤ k → ∀ A ⊆ Finset.Icc 1 (6 * k + 1),
      4 * k < A.card → ∀ l, Odd l → 5 ≤ l → l ≤ 2 * k + 1 → hasOrder A l)
    (hLast : ∀ k : ℕ, 3 ≤ k → ∀ A ⊆ Finset.Icc 1 (6 * k + 5),
      Finset.Icc (6 * k + 2) (6 * k + 5) ⊆ A → A.card = 4 * k + 4 →
        ∀ l, Odd l → 5 ≤ l → l ≤ 2 * k + 1 → hasOrder A l) :
    ∀ n : ℕ, 18 ≤ n → ∀ A ⊆ Finset.Icc 1 n,
      n / 2 + n / 3 - n / 6 < A.card →
        ∀ l, Odd l → 5 ≤ l → l ≤ n / 3 + 1 → hasOrder A l := by
  intro n hn A hA hcard l hlOdd hlMin hlMax
  let k := n / 6
  have hk : 3 ≤ k := by omega
  have hnk : 6 * k ≤ n ∧ n ≤ 6 * k + 5 := by omega
  have hl : l ≤ 2 * k + 1 := by
    obtain ⟨j, hj⟩ := hlOdd
    omega
  let B := A.filter fun x => x ≤ 6 * k + 1
  let C := A.filter fun x => ¬ x ≤ 6 * k + 1
  have hB : B ⊆ Finset.Icc 1 (6 * k + 1) := by
    intro x hx
    obtain ⟨hxA, hxBound⟩ := Finset.mem_filter.mp hx
    exact Finset.mem_Icc.mpr ⟨(Finset.mem_Icc.mp (hA hxA)).1, hxBound⟩
  by_cases hd : 4 * k < B.card
  · exact hasOrder_mono (Finset.filter_subset ..) (hFirst k hk B hB hd l hlOdd hlMin hl)
  have hC : C ⊆ Finset.Icc (6 * k + 2) n := by
    intro x hx
    obtain ⟨hxA, hxBound⟩ := Finset.mem_filter.mp hx
    exact Finset.mem_Icc.mpr ⟨by omega, (Finset.mem_Icc.mp (hA hxA)).2⟩
  have hpart : B.card + C.card = A.card :=
    Finset.card_filter_add_card_filter_not (s := A) (p := fun x => x ≤ 6 * k + 1)
  have hCcard := Finset.card_le_card hC
  rw [Nat.card_Icc] at hCcard
  have hnLast : n = 6 * k + 5 := by omega
  have hAc : A.card = 4 * k + 4 := by omega
  have hTail : C = Finset.Icc (6 * k + 2) n := by
    apply Finset.eq_of_subset_of_card_le hC
    rw [Nat.card_Icc]
    omega
  have hA' : A ⊆ Finset.Icc 1 (6 * k + 5) := hnLast ▸ hA
  have hTailA : Finset.Icc (6 * k + 2) (6 * k + 5) ⊆ A := by
    rw [← hnLast, ← hTail]
    exact Finset.filter_subset ..
  exact hLast k hk A hA' hTailA hAc l hlOdd hlMin hl


theorem erdos_883__h1__h1__h1 : ∀ (n : ℕ),
  (18 : ℕ) ≤ n →
    ∀ A ⊆ Finset.Icc (1 : ℕ) n,
      n / (2 : ℕ) + n / (3 : ℕ) - n / (6 : ℕ) < A.card →
        ∀ (l : ℕ),
          Odd l →
            (5 : ℕ) ≤ l →
              l ≤ n / (3 : ℕ) + (1 : ℕ) →
                ∃ (f : Fin l → ℕ),
                  Function.Injective f ∧
                    (∀ (i : Fin l), f i ∈ A) ∧ ∀ (i j : Fin l), (SimpleGraph.cycleGraph l).Adj i j → (f i).Coprime (f j) := by
  -- approach: Cut each interval at 6k+1 and compare its loss in vertices with the decrease in the density threshold.
  -- licence: Apache-2.0
  -- label: Coprime cyclic orderings on intervals ending at 6k+1
  -- claim: $\forall k\ge3,\ \forall A\subseteq[1,6k+1],\ |A|>4k\ \Rightarrow\ \forall\text{ odd }l\in[5,2k+1],\ \exists\text{ an injective coprime cyclic ordering of length }l\text{ in }A$
  -- Consecutive entries, including the last and first, must be coprime.
  have h_first : ∀ k : ℕ, 3 ≤ k → ∀ A ⊆ Finset.Icc 1 (6 * k + 1),
      4 * k < A.card → ∀ l, Odd l → 5 ≤ l → l ≤ 2 * k + 1 →
        ∃ f : Fin l → ℕ, Function.Injective f ∧ (∀ i, f i ∈ A) ∧
          ∀ i j : Fin l, (SimpleGraph.cycleGraph l).Adj i j → (f i).Coprime (f j) := sorry
  -- label: Minimum-size sets containing the four final vertices
  -- claim: $\forall k\ge3,\ \forall A\subseteq[1,6k+5],\ [6k+2,6k+5]\subseteq A\ \land\ |A|=4k+4\ \Rightarrow\ \forall\text{ odd }l\in[5,2k+1],\ \exists\text{ an injective coprime cyclic ordering of length }l\text{ in }A$
  -- Consecutive entries, including the last and first, must be coprime.
  have h_last : ∀ k : ℕ, 3 ≤ k → ∀ A ⊆ Finset.Icc 1 (6 * k + 5),
      Finset.Icc (6 * k + 2) (6 * k + 5) ⊆ A → A.card = 4 * k + 4 →
        ∀ l, Odd l → 5 ≤ l → l ≤ 2 * k + 1 →
          ∃ f : Fin l → ℕ, Function.Injective f ∧ (∀ i, f i ∈ A) ∧
            ∀ i j : Fin l, (SimpleGraph.cycleGraph l).Adj i j → (f i).Coprime (f j) := sorry
  exact erdos883_sixBlock_reduction h_first h_last
