theorem witness : ∃ (k : ℕ) (A : Finset ℕ) (l : ℕ), 3 ≤ k ∧
    A ⊆ Finset.Icc 1 (6 * k + 5) ∧ Finset.Icc (6 * k + 2) (6 * k + 5) ⊆ A ∧
      A.card = 4 * k + 4 ∧ Odd l ∧ 5 ≤ l ∧ l ≤ 2 * k + 1 :=
  ⟨3, Finset.Icc 8 23, 7, by decide, by decide, by decide, by decide,
    ⟨3, rfl⟩, by decide, by decide⟩
