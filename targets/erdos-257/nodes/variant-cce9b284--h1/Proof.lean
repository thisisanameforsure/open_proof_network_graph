private lemma t_nonneg (m : ℕ) : 0 ≤ (1 : ℝ) / (2 ^ m - 1) := by
  apply div_nonneg zero_le_one
  have : (1 : ℝ) ≤ 2 ^ m := one_le_pow₀ (by norm_num)
  linarith

private lemma walk_step_le (r t : ℝ) (ht : 0 ≤ t) (hr : 0 ≤ r) :
    (⌊r / t⌋₊ : ℝ) * t ≤ r := by
  rcases ht.lt_or_eq with ht' | ht'
  · have hfl := Nat.floor_le (div_nonneg hr ht)
    calc (⌊r / t⌋₊ : ℝ) * t ≤ r / t * t := mul_le_mul_of_nonneg_right hfl ht
      _ = r := div_mul_cancel₀ r ht'.ne'
  · subst ht'
    simp [hr]

private lemma walk_nonneg (x : ℚ) (r : ℕ → ℝ) (q : ℕ → ℕ) (hx : 0 ≤ x) (h0 : r 0 = x)
    (h : ∀ m : ℕ, q m = ⌊r m / ((1 : ℝ) / (2 ^ m - 1))⌋₊ ∧
      r (m + 1) = r m - q m * ((1 : ℝ) / (2 ^ m - 1))) : ∀ m, 0 ≤ r m := by
  intro m
  induction m with
  | zero => rw [h0]; exact_mod_cast hx
  | succ n ih =>
    rw [(h n).2, (h n).1]
    have := walk_step_le (r n) _ (t_nonneg n) ih
    linarith

private lemma t_tendsto :
    Filter.Tendsto (fun N : ℕ => (1 : ℝ) / (2 ^ N - 1)) Filter.atTop (nhds 0) := by
  have h1 : Filter.Tendsto (fun N : ℕ => (2 : ℝ) ^ N + (-1)) Filter.atTop Filter.atTop :=
    Filter.tendsto_atTop_add_const_right _ (-1) (tendsto_pow_atTop_atTop_of_one_lt (by norm_num))
  exact h1.inv_tendsto_atTop.congr fun N => by simp [one_div, sub_eq_add_neg]

private lemma walk_tendsto (x : ℚ) (r : ℕ → ℝ) (q : ℕ → ℕ) (hx : 0 ≤ x) (h0 : r 0 = x)
    (h : ∀ m : ℕ, q m = ⌊r m / ((1 : ℝ) / (2 ^ m - 1))⌋₊ ∧
      r (m + 1) = r m - q m * ((1 : ℝ) / (2 ^ m - 1))) :
    Filter.Tendsto r Filter.atTop (nhds 0) := by
  have hnn := walk_nonneg x r q hx h0 h
  rw [← Filter.tendsto_add_atTop_iff_nat 1]
  apply squeeze_zero' (Filter.Eventually.of_forall (fun N => hnn (N + 1))) _ t_tendsto
  filter_upwards [Filter.eventually_ge_atTop 1] with N hN
  have ht : 0 < (1 : ℝ) / (2 ^ N - 1) := by
    apply div_pos one_pos
    have : (2 : ℝ) ≤ 2 ^ N := by
      calc (2 : ℝ) = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ N := pow_le_pow_right₀ (by norm_num) hN
    linarith
  have hlt := Nat.lt_floor_add_one (r N / ((1 : ℝ) / (2 ^ N - 1)))
  rw [div_lt_iff₀ ht, add_mul, one_mul] at hlt
  rw [(h N).2, (h N).1]
  linarith

private lemma walk_hasSum (x : ℚ) (r : ℕ → ℝ) (q : ℕ → ℕ) (hx : 0 ≤ x) (h0 : r 0 = x)
    (h : ∀ m : ℕ, q m = ⌊r m / ((1 : ℝ) / (2 ^ m - 1))⌋₊ ∧
      r (m + 1) = r m - q m * ((1 : ℝ) / (2 ^ m - 1))) :
    HasSum (fun m : ℕ => (q m : ℝ) * ((1 : ℝ) / (2 ^ m - 1))) x := by
  have hf : ∀ m, 0 ≤ (q m : ℝ) * ((1 : ℝ) / (2 ^ m - 1)) :=
    fun m => mul_nonneg (Nat.cast_nonneg _) (t_nonneg m)
  rw [hasSum_iff_tendsto_nat_of_nonneg hf]
  have hpart : ∀ N, ∑ i ∈ Finset.range N, (q i : ℝ) * ((1 : ℝ) / (2 ^ i - 1)) = x - r N := by
    intro N
    have hi : ∀ i, (q i : ℝ) * ((1 : ℝ) / (2 ^ i - 1)) = r i - r (i + 1) := fun i => by
      rw [(h i).2]; ring
    rw [Finset.sum_congr rfl (fun i _ => hi i), Finset.sum_range_sub', h0]
  simp_rw [hpart]
  simpa using tendsto_const_nhds.sub (walk_tendsto x r q hx h0 h)

