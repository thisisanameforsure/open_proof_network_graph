private def opnLoop (D : ℕ) : ℕ → ℕ → ℕ → ℕ → Bool
  | 0, _, _, _ => true
  | f + 1, k, lo, hi =>
    if D ≤ lo * (2 ^ k - 1) then
      (decide (D / (2 ^ k - 1) + 1 ≤ lo) && decide (D / (2 ^ k - 1) ≤ hi)) &&
        opnLoop D f (k + 1) (lo - (D / (2 ^ k - 1) + 1)) (hi - D / (2 ^ k - 1))
    else
      (decide (hi * (2 ^ k - 1) < D) && decide (hi * 3 * 4 ^ k ≤ D * (3 * 2 ^ k + 1))) &&
        opnLoop D f (k + 1) lo hi

