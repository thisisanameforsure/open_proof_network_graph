              C * ((↑j : ℤ) + (1 : ℤ))) →
        ∑' (m : ℕ), (↑{a : ℕ | a ∈ A ∧ (0 : ℕ) < m ∧ a ∣ m}.ncard : ℝ) / (2 : ℝ) ^ m = (↑p : ℝ) / (↑q : ℝ) := by
  intro A p q hq hZ hCb
  obtain ⟨C, hC⟩ := hCb
  set D : ℕ → ℕ := fun m => Set.ncard {a ∈ A | 0 < m ∧ a ∣ m} with hD
  set Z : ℕ → ℤ := fun j => p * (2 : ℤ) ^ j - (q : ℤ) *
    ∑ m ∈ Finset.range (j + 1), ((D m : ℕ) : ℤ) * (2 : ℤ) ^ (j - m) with hZdef
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have key : ∀ j : ℕ, ∑ m ∈ Finset.range (j + 1), (D m : ℝ) / 2 ^ m
      = p / q - (Z j : ℝ) / (q * 2 ^ j) := by
    intro j
    have hsum : (∑ m ∈ Finset.range (j + 1), ((D m : ℕ) : ℤ) * (2 : ℤ) ^ (j - m) : ℤ)
        = 2 ^ j * ∑ m ∈ Finset.range (j + 1), (D m : ℝ) / 2 ^ m := by
      push_cast
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl ?_
      intro m hm
      have hmj : m ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hm)
      have h2 : (2 : ℝ) ^ j = 2 ^ (j - m) * 2 ^ m := by
        rw [← pow_add, Nat.sub_add_cancel hmj]
      rw [h2]
      field_simp
    have hZR : (Z j : ℝ) = p * 2 ^ j - q * (2 ^ j * ∑ m ∈ Finset.range (j + 1), (D m : ℝ) / 2 ^ m) := by
      rw [← hsum]; simp [hZdef]
    rw [hZR]
    field_simp
    ring
  have hlin : Filter.Tendsto (fun n : ℕ => ((n : ℝ) + 1) / 2 ^ n) Filter.atTop (nhds 0) := by
    have h1 := tendsto_pow_const_div_const_pow_of_one_lt 1 (by norm_num : (1 : ℝ) < 2)
    have h2 : Filter.Tendsto (fun n : ℕ => ((1 : ℝ) / 2) ^ n) Filter.atTop (nhds 0) :=
