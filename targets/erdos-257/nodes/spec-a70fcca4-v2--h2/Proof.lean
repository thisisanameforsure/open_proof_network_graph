theorem spec_a70fcca4_v2__h2 : ∀ (A : Set ℕ) (p : ℤ) (q : ℕ),
  (0 : ℕ) < q →
    (∀ (j : ℕ),
        (0 : ℤ) ≤
          p * (2 : ℤ) ^ j -
            (↑q : ℤ) *
