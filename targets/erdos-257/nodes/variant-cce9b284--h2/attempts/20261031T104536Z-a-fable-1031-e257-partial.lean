theorem variant_cce9b284__h2 : ∃ (x : ℚ) (r : ℕ → ℝ) (q : ℕ → ℕ),
  (0 : ℚ) < x ∧
    r (0 : ℕ) = (↑x : ℝ) ∧
      (∀ (m : ℕ),
          q m = ⌊r m / ((1 : ℝ) / ((2 : ℝ) ^ m - (1 : ℝ)))⌋₊ ∧
            r (m + (1 : ℕ)) = r m - (↑(q m) : ℝ) * ((1 : ℝ) / ((2 : ℝ) ^ m - (1 : ℝ)))) ∧
        {m : ℕ |
              q m ≠ (0 : ℕ) ∧
                r (m + (1 : ℕ)) ≤ ∑' (j : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (m + (1 : ℕ) + j) - (1 : ℝ))}.Infinite ∧
          ∃ (s : ℚ),
            ∑' (m : ℕ),
                ((↑(q m) : ℝ) -
                    if
                        q m ≠ (0 : ℕ) ∧
                          r (m + (1 : ℕ)) ≤ ∑' (j : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (m + (1 : ℕ) + j) - (1 : ℝ)) then
                      (1 : ℝ)
                    else (0 : ℝ)) *
                  ((1 : ℝ) / ((2 : ℝ) ^ m - (1 : ℝ))) =
              (↑s : ℝ) := by
  -- approach: finitely many repairs: a positive rational with even denominator whose walk repairs only finitely often; the repair sum is then a finite rational sum with odd denominator, so by parity the chosen set cannot be finite
  -- licence: CC-BY-4.0
  have hall :
      (∃ (x : ℚ) (r : ℕ → ℝ) (q : ℕ → ℕ), 0 < x ∧ Even x.den ∧ r 0 = x ∧
          (∀ m : ℕ, q m = ⌊r m / ((1 : ℝ) / (2 ^ m - 1))⌋₊ ∧
            r (m + 1) = r m - q m * ((1 : ℝ) / (2 ^ m - 1))) ∧
          {m : ℕ | ((q m : ℝ) -
              if q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1) then 1 else 0) ≠ 0}.Finite) ∧
      (∀ (x : ℚ) (r : ℕ → ℝ) (q : ℕ → ℕ), 0 ≤ x → r 0 = x →
          (∀ m : ℕ, q m = ⌊r m / ((1 : ℝ) / (2 ^ m - 1))⌋₊ ∧
            r (m + 1) = r m - q m * ((1 : ℝ) / (2 ^ m - 1))) →
          ∑' n : {m : ℕ | q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1)},
              (1 : ℝ) / (2 ^ n.1 - 1) =
            x - ∑' m : ℕ, ((q m : ℝ) -
              if q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1) then 1 else 0) *
                ((1 : ℝ) / (2 ^ m - 1))) ∧
      (∀ (x : ℚ) (r : ℕ → ℝ) (q : ℕ → ℕ), 0 ≤ x → r 0 = x →
          (∀ m : ℕ, q m = ⌊r m / ((1 : ℝ) / (2 ^ m - 1))⌋₊ ∧
            r (m + 1) = r m - q m * ((1 : ℝ) / (2 ^ m - 1))) →
          ∑' n : {m : ℕ | q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1)},
              (1 : ℝ) / (2 ^ n.1 - 1) =
            x - ∑' m : ℕ, ((q m : ℝ) -
              if q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1) then 1 else 0) *
                ((1 : ℝ) / (2 ^ m - 1)) →
          {m : ℕ | ((q m : ℝ) -
              if q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1) then 1 else 0) ≠ 0}.Finite →
          Odd x.den ∨
            ({m : ℕ | q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1)}.Infinite ∧
              ∃ s : ℚ, ∑' m : ℕ, ((q m : ℝ) -
              if q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1) then 1 else 0) *
                ((1 : ℝ) / (2 ^ m - 1)) = s)) := by
    refine ⟨?_, ?_, ?_⟩
    ·
      -- label: an even-denominator rational with finitely many repairs
      -- claim: $\exists x\in\mathbb{Q}_{>0},\ 2\mid\operatorname{den}(x):\ \#\{m: q_m-\mathbf 1_{A(x)}(m)\ne 0\}<\infty$
      -- Some positive rational with even denominator whose walk (r_0 = x, q_m = ⌊r_m (2^m - 1)⌋,
      -- r_{m+1} = r_m - q_m/(2^m - 1)) makes only finitely many repairs: at all but finitely
      -- many indices the term is subtracted at most once, and then as a chosen term.
      have h_finite : ∃ (x : ℚ) (r : ℕ → ℝ) (q : ℕ → ℕ), 0 < x ∧ Even x.den ∧ r 0 = x ∧
          (∀ m : ℕ, q m = ⌊r m / ((1 : ℝ) / (2 ^ m - 1))⌋₊ ∧
            r (m + 1) = r m - q m * ((1 : ℝ) / (2 ^ m - 1))) ∧
          {m : ℕ | ((q m : ℝ) -
              if q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1) then 1 else 0) ≠ 0}.Finite := by
        sorry
      exact h_finite
    ·
      -- label: the walk accounts for x
      -- claim: $\sum_{m\in A}\frac{1}{2^m-1}=x-\sum_{m}\bigl(q_m-\mathbf 1_A(m)\bigr)\frac{1}{2^m-1}$
      -- The chosen sum is x less the repair sum, for the walk of any rational x ≥ 0 (the sibling
      -- statement under the parent, restated here so this route may use it).
      have h_account : ∀ (x : ℚ) (r : ℕ → ℝ) (q : ℕ → ℕ), 0 ≤ x → r 0 = x →
          (∀ m : ℕ, q m = ⌊r m / ((1 : ℝ) / (2 ^ m - 1))⌋₊ ∧
            r (m + 1) = r m - q m * ((1 : ℝ) / (2 ^ m - 1))) →
          ∑' n : {m : ℕ | q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1)},
              (1 : ℝ) / (2 ^ n.1 - 1) =
            x - ∑' m : ℕ, ((q m : ℝ) -
              if q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1) then 1 else 0) *
                ((1 : ℝ) / (2 ^ m - 1)) := by
        sorry
      exact h_account
    ·
      -- label: parity of a finite repair sum
      -- claim: $\#\{m: q_m-\mathbf 1_A(m)\ne 0\}<\infty\ \Rightarrow\ 2\nmid\operatorname{den}(x)\ \text{ or }\ \bigl(A\ \text{infinite}\wedge \sum_m (q_m-\mathbf 1_A(m))\tfrac{1}{2^m-1}\in\mathbb{Q}\bigr)$
      -- Given the walk of x ≥ 0, the accounting identity for it, and finitely many repairs: either
      -- x has odd denominator, or the chosen set is infinite and the repair sum is rational. Finite
      -- sums of the terms 1/(2^m - 1) have odd denominators, which is where the denominator enters.
      have h_parity : ∀ (x : ℚ) (r : ℕ → ℝ) (q : ℕ → ℕ), 0 ≤ x → r 0 = x →
          (∀ m : ℕ, q m = ⌊r m / ((1 : ℝ) / (2 ^ m - 1))⌋₊ ∧
            r (m + 1) = r m - q m * ((1 : ℝ) / (2 ^ m - 1))) →
          ∑' n : {m : ℕ | q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1)},
              (1 : ℝ) / (2 ^ n.1 - 1) =
            x - ∑' m : ℕ, ((q m : ℝ) -
              if q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1) then 1 else 0) *
                ((1 : ℝ) / (2 ^ m - 1)) →
          {m : ℕ | ((q m : ℝ) -
              if q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1) then 1 else 0) ≠ 0}.Finite →
          Odd x.den ∨
            ({m : ℕ | q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1)}.Infinite ∧
              ∃ s : ℚ, ∑' m : ℕ, ((q m : ℝ) -
              if q m ≠ 0 ∧ r (m + 1) ≤ ∑' j : ℕ, (1 : ℝ) / (2 ^ (m + 1 + j) - 1) then 1 else 0) *
                ((1 : ℝ) / (2 ^ m - 1)) = s) := by
        sorry
      exact h_parity
  obtain ⟨⟨x, r, q, hx, hden, h0, hrec, hfin⟩, h_account, h_parity⟩ := hall
  rcases h_parity x r q hx.le h0 hrec (h_account x r q hx.le h0 hrec) hfin with hodd | ⟨hA, s, hs⟩
  · exact absurd hodd (Nat.not_odd_iff_even.mpr hden)
  · exact ⟨x, r, q, hx, h0, hrec, hA, s, hs⟩
