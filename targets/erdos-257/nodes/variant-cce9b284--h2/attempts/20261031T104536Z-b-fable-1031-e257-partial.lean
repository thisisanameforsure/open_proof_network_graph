                    if
                        q m ≠ (0 : ℕ) ∧
                          r (m + (1 : ℕ)) ≤ ∑' (j : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (m + (1 : ℕ) + j) - (1 : ℝ)) then
                      (1 : ℝ)
                    else (0 : ℝ)) *
                  ((1 : ℝ) / ((2 : ℝ) ^ m - (1 : ℝ))) =
              (↑s : ℝ) := by
  -- approach: infinitely many repairs: a positive rational whose walk repairs infinitely often and whose repair sum is nonetheless rational, with the chosen set infinite
  -- licence: CC-BY-4.0
  -- label: infinitely many repairs with a rational sum
  -- claim: $\exists x\in\mathbb{Q}_{>0}:\ A(x)\ \text{infinite},\ \#\{m: q_m-\mathbf 1_{A(x)}(m)\ne 0\}=\infty,\ \sum_m (q_m-\mathbf 1_{A(x)}(m))\tfrac{1}{2^m-1}\in\mathbb{Q}$
  -- Some positive rational whose walk (r_0 = x, q_m = ⌊r_m (2^m - 1)⌋, r_{m+1} = r_m - q_m/(2^m - 1))
  -- chooses infinitely many indices, repairs at infinitely many, and whose repair sum is rational.
  have h_infinite : ∃ (x : ℚ) (r : ℕ → ℝ) (q : ℕ → ℕ), 0 < x ∧ r 0 = x ∧
          (∀ m : ℕ, q m = ⌊r m / ((1 : ℝ) / (2 ^ m - 1))⌋₊ ∧
