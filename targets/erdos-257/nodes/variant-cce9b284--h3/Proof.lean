private lemma h3_walk_sum (r : ℕ → ℝ)
    (hr : ∀ k : ℕ, r (k + 1) = if 1 ≤ k ∧ (1:ℝ) / ((2:ℝ)^k - 1) ≤ r k
      then r k - (1:ℝ) / ((2:ℝ)^k - 1) else r k) (n : ℕ) :
    r (n + 1) = r 0 - ∑ k ∈ (Finset.range (n+1)).filter
      (fun k => 1 ≤ k ∧ (1:ℝ) / ((2:ℝ)^k - 1) ≤ r k), (1:ℝ) / ((2:ℝ)^k - 1) := by
  rw [Finset.sum_filter]
  induction n with
  | zero => rw [hr 0]; simp
  | succ n ih =>
    rw [Finset.sum_range_succ, hr (n+1), ih]
    split_ifs <;> ring

private lemma h3_summ (a m : ℕ) :
    Summable (fun i : ℕ => (1/2:ℝ)^(i+1) * (if a ∣ m + i + 1 then (1:ℝ) else 0)) := by
  refine Summable.of_nonneg_of_le (fun i => ?_) (fun i => ?_) summable_geometric_two
  · split_ifs <;> positivity
  · have h0 : (0:ℝ) ≤ (1/2:ℝ)^i := by positivity
    split_ifs
    · rw [mul_one, pow_succ]; linarith
    · rw [mul_zero]; exact h0

private lemma h3_F0 (a : ℕ) (ha : 1 ≤ a) :
    ∑' i : ℕ, (1/2:ℝ)^(i+1) * (if a ∣ 0 + i + 1 then (1:ℝ) else 0) = 1 / ((2:ℝ)^a - 1) := by
  have hs := h3_summ a 0
  have h1 := hs.sum_add_tsum_nat_add a
  have h2 : ∑ i ∈ Finset.range a, (1/2:ℝ)^(i+1) * (if a ∣ 0 + i + 1 then (1:ℝ) else 0)
      = (1/2:ℝ)^a := by
    rw [Finset.sum_eq_single (a-1)]
    · have e : 0 + (a - 1) + 1 = a := by omega
      rw [e, if_pos (dvd_refl a), mul_one, Nat.sub_add_cancel ha]
    · intro b hb hne
      have hnd : ¬ a ∣ 0 + b + 1 := by
        intro hd
        have := Nat.le_of_dvd (by omega) hd
        rw [Finset.mem_range] at hb
        omega
      rw [if_neg hnd, mul_zero]
    · intro h
      rw [Finset.mem_range] at h
      omega
  have h3 : ∑' i : ℕ, (1/2:ℝ)^(i + a + 1) * (if a ∣ 0 + (i + a) + 1 then (1:ℝ) else 0)
      = (1/2:ℝ)^a * ∑' i : ℕ, (1/2:ℝ)^(i+1) * (if a ∣ 0 + i + 1 then (1:ℝ) else 0) := by
    rw [← tsum_mul_left]
    congr 1
    funext i
    have e : 0 + (i + a) + 1 = (0 + i + 1) + a := by omega
    have hd : (a ∣ 0 + (i + a) + 1) ↔ (a ∣ 0 + i + 1) := by rw [e, Nat.dvd_add_self_right]
    simp only [hd]
    rw [show i + a + 1 = (i + 1) + a by omega, pow_add]
    ring
  rw [h2, h3] at h1
  set F := ∑' i : ℕ, (1/2:ℝ)^(i+1) * (if a ∣ 0 + i + 1 then (1:ℝ) else 0) with hF
  have hq : (1/2:ℝ)^a * (2:ℝ)^a = 1 := by rw [← mul_pow]; norm_num
  have hpos : (0:ℝ) < (2:ℝ)^a - 1 := by
    have : (2:ℝ) ≤ (2:ℝ)^a := by
      calc (2:ℝ) = 2^1 := by norm_num
        _ ≤ 2^a := pow_le_pow_right₀ (by norm_num) ha
    linarith
  rw [eq_div_iff hpos.ne']
  linear_combination (-(2:ℝ)^a) * h1 + (F + 1) * hq

private lemma h3_rec (a m : ℕ) :
    ∑' i : ℕ, (1/2:ℝ)^(i+1) * (if a ∣ m + 1 + i + 1 then (1:ℝ) else 0)
      = 2 * ∑' i : ℕ, (1/2:ℝ)^(i+1) * (if a ∣ m + i + 1 then (1:ℝ) else 0)
        - (if a ∣ m + 1 then (1:ℝ) else 0) := by
  have h : ∑' i : ℕ, (1/2:ℝ)^(i+1) * (if a ∣ m + i + 1 then (1:ℝ) else 0)
      = (1/2:ℝ)^(0+1) * (if a ∣ m + 0 + 1 then (1:ℝ) else 0)
        + ∑' i : ℕ, (1/2:ℝ)^(i+1+1) * (if a ∣ m + (i+1) + 1 then (1:ℝ) else 0) :=
    (h3_summ a m).tsum_eq_zero_add
  have h' : ∑' i : ℕ, (1/2:ℝ)^(i+1+1) * (if a ∣ m + (i+1) + 1 then (1:ℝ) else 0)
      = (1/2:ℝ) * ∑' i : ℕ, (1/2:ℝ)^(i+1) * (if a ∣ m + 1 + i + 1 then (1:ℝ) else 0) := by
    rw [← tsum_mul_left]
    congr 1
    funext i
    have e2 : m + (i + 1) + 1 = m + 1 + i + 1 := by omega
    rw [e2, pow_succ]
    ring
  rw [h', add_zero] at h
  linarith

private lemma h3_int (a : ℕ) (ha : 1 ≤ a) (m : ℕ) :
    ∃ z : ℤ, (2:ℝ)^m * (1 / ((2:ℝ)^a - 1))
      - ∑' i : ℕ, (1/2:ℝ)^(i+1) * (if a ∣ m + i + 1 then (1:ℝ) else 0) = z := by
  induction m with
  | zero => exact ⟨0, by rw [h3_F0 a ha]; simp⟩
  | succ m ih =>
    obtain ⟨z, hz⟩ := ih
    refine ⟨2 * z + (if a ∣ m + 1 then 1 else 0), ?_⟩
    rw [h3_rec a m, pow_succ]
    by_cases hd : a ∣ m + 1
    · simp only [hd, if_true]
      push_cast
      linear_combination 2 * hz
    · simp only [hd, if_false]
      push_cast
      linear_combination 2 * hz

private lemma h3_assembly (A : Finset ℕ) (hA : ∀ a ∈ A, 1 ≤ a) (m : ℕ) :
    ∃ z : ℤ, (2:ℝ)^m * ∑ a ∈ A, (1 / ((2:ℝ)^a - 1))
      - ∑' i : ℕ, (1/2:ℝ)^(i+1) * ((A.filter (fun a => a ∣ m + i + 1)).card : ℝ) = z := by
  have hW : ∑' i : ℕ, (1/2:ℝ)^(i+1) * ((A.filter (fun a => a ∣ m + i + 1)).card : ℝ)
      = ∑ a ∈ A, ∑' i : ℕ, (1/2:ℝ)^(i+1) * (if a ∣ m + i + 1 then (1:ℝ) else 0) := by
    rw [← Summable.tsum_finsetSum (fun a _ => h3_summ a m)]
    congr 1
    funext i
    rw [Finset.card_filter, Nat.cast_sum, Finset.mul_sum]
    congr 1
    funext a
    split_ifs <;> simp
  rw [hW, Finset.mul_sum, ← Finset.sum_sub_distrib]
  clear hW
  induction A using Finset.induction_on with
  | empty => exact ⟨0, by simp⟩
  | @insert b s hb ih =>
    obtain ⟨z1, hz1⟩ := ih (fun a ha => hA a (Finset.mem_insert_of_mem ha))
    obtain ⟨z2, hz2⟩ := h3_int b (hA b (Finset.mem_insert_self b s)) m
    refine ⟨z2 + z1, ?_⟩
    rw [Finset.sum_insert hb, hz1, hz2]
    push_cast
    ring

private lemma h3_tail (n : ℕ) :
    (1/2:ℝ)^(n+1) ≤ ∑' i : ℕ, (1:ℝ) / ((2:ℝ)^(n+2+i) - 1) := by
  have h2 : ∀ k : ℕ, 1 ≤ k → (2:ℝ) ≤ (2:ℝ)^k := by
    intro k hk
    calc (2:ℝ) = 2^1 := by norm_num
      _ ≤ 2^k := pow_le_pow_right₀ (by norm_num) hk
  have hq : ∀ k : ℕ, (1/2:ℝ)^k * (2:ℝ)^k = 1 := by
    intro k; rw [← mul_pow]; norm_num
  have hlo : ∀ k : ℕ, 1 ≤ k → (1/2:ℝ)^k ≤ (1:ℝ) / ((2:ℝ)^k - 1) := by
    intro k hk
    have := h2 k hk
    have := hq k
    have : (0:ℝ) ≤ (1/2:ℝ)^k := by positivity
    rw [le_div_iff₀ (by linarith)]
    nlinarith
  have hhi : ∀ k : ℕ, 1 ≤ k → (1:ℝ) / ((2:ℝ)^k - 1) ≤ 2 * (1/2:ℝ)^k := by
    intro k hk
    have h2k := h2 k hk
    have hqk := hq k
    have : (0:ℝ) ≤ (1/2:ℝ)^k := by positivity
    rw [div_le_iff₀ (by linarith)]
    nlinarith [mul_nonneg this (by linarith : (0:ℝ) ≤ (2:ℝ)^k - 2)]
  have hG : Summable (fun i : ℕ => (1/2:ℝ)^(n+2+i)) :=
    summable_geometric_two.comp_injective (add_right_injective (n+2))
  have hT : Summable (fun i : ℕ => (1:ℝ) / ((2:ℝ)^(n+2+i) - 1)) :=
    (hG.mul_left 2).of_nonneg_of_le
      (fun i => le_trans (by positivity) (hlo _ (by omega))) (fun i => hhi _ (by omega))
  have hval : ∑' i : ℕ, (1/2:ℝ)^(n+2+i) = (1/2:ℝ)^(n+1) := by
    have : (fun i : ℕ => (1/2:ℝ)^(n+2+i)) = fun i => (1/2:ℝ)^(n+2) * (1/2:ℝ)^i := by
      funext i; rw [pow_add]
    rw [this, tsum_mul_left, tsum_geometric_two, pow_succ]
    ring
  rw [← hval]
  exact Summable.tsum_le_tsum (fun i => hlo _ (by omega)) hG hT

private lemma h3_upper (n k : ℕ) (h : k + 11 ≤ n) :
    (2:ℝ)^(n+k+1) * (1 / ((2:ℝ)^(n+1) - 1)) ≤ (2:ℝ)^k + 1/100 := by
  have e : (2:ℝ)^(n+k+1) = (2:ℝ)^(n+1) * (2:ℝ)^k := by
    rw [← pow_add]; congr 1; omega
  have hu : (2:ℝ)^k * 4096 ≤ (2:ℝ)^(n+1) := by
    calc (2:ℝ)^k * 4096 = 2^(k+12) := by rw [pow_add]; norm_num
      _ ≤ 2^(n+1) := pow_le_pow_right₀ (by norm_num) (by omega)
  have hv : (1:ℝ) ≤ (2:ℝ)^k := one_le_pow₀ (by norm_num)
  rw [e, mul_one_div, div_le_iff₀ (by linarith)]
  nlinarith

