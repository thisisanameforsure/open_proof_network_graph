    · rintro ⟨⟨h1, h2, h3⟩, h4⟩; exact ⟨h2, by omega, h3, h4⟩
  simp only [hset]
  set W := ∑' i : ℕ, (1/2:ℝ)^(i+1) * ((B.filter (fun a => a ∣ n + k + 1 + i + 1)).card : ℝ)
    with hWdef
  have hW0 : 0 ≤ W := tsum_nonneg (fun i => by positivity)
  obtain ⟨z, hz⟩ := h3_assembly B (fun a ha => (Finset.mem_filter.mp ha).2.1) (n + k + 1)
