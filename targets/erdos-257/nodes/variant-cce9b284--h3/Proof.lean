  obtain ⟨k, rfl⟩ : ∃ k, m = n + k + 1 := ⟨m - n - 1, by omega⟩
  obtain ⟨d, hd⟩ : ∃ d, n + k + 1 = L + d := ⟨n + k + 1 - L, by omega⟩
  have hwalk := h3_walk_sum r hr n
