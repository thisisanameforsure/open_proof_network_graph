import Mathlib
import Nodes.«variant-cce9b284--h7».Context

/-! Hole `h_no_stall_sums` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

private lemma opn_term_nonneg (k : ℕ) : (0 : ℝ) ≤ (1 : ℝ) / ((2 : ℝ) ^ k - 1) := by
  rcases Nat.eq_zero_or_pos k with hk | hk
  · subst hk; norm_num
  · have h2 : (1 : ℝ) < (2 : ℝ) ^ k := one_lt_pow₀ (by norm_num) (by omega)
    exact div_nonneg zero_le_one (by linarith)

/-- every term is at most twice the geometric term -/
private lemma opn_term_le (k : ℕ) : (1 : ℝ) / ((2 : ℝ) ^ k - 1) ≤ 2 * (1 / 2 : ℝ) ^ k := by
  rcases Nat.eq_zero_or_pos k with hk | hk
  · subst hk; norm_num
  · have h2k : (2 : ℝ) ≤ (2 : ℝ) ^ k := by
      calc (2 : ℝ) = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hk
    have hpos : (0 : ℝ) < (2 : ℝ) ^ k / 2 := by positivity
    calc (1 : ℝ) / ((2 : ℝ) ^ k - 1) ≤ 1 / ((2 : ℝ) ^ k / 2) :=
          one_div_le_one_div_of_le hpos (by linarith)
      _ = 2 * (1 / 2 : ℝ) ^ k := by rw [one_div_pow]; field_simp

private lemma opn_summable_terms : Summable (fun k : ℕ => (1 : ℝ) / ((2 : ℝ) ^ k - 1)) :=
  (summable_geometric_two.mul_left 2).of_nonneg_of_le opn_term_nonneg opn_term_le

/-- the sum of the terms with index at least `n + 2` -/
private noncomputable def opnTail (n : ℕ) : ℝ := ∑' (i : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (n + 2 + i) - 1)

private lemma opn_summable_tail (n : ℕ) :
    Summable (fun i : ℕ => (1 : ℝ) / ((2 : ℝ) ^ (n + 2 + i) - 1)) :=
  opn_summable_terms.comp_injective (add_right_injective (n + 2))

private lemma opn_tail_nonneg (n : ℕ) : 0 ≤ opnTail n :=
  tsum_nonneg (fun i => opn_term_nonneg _)

private lemma opn_tail_succ (n : ℕ) :
    opnTail n = (1 : ℝ) / ((2 : ℝ) ^ (n + 2) - 1) + opnTail (n + 1) := by
  unfold opnTail
  rw [(opn_summable_tail n).tsum_eq_zero_add, add_zero]
  congr 1
  apply tsum_congr
  intro i
  rw [show n + 2 + (i + 1) = n + 1 + 2 + i by omega]

/-- the tail after `n + 1` is at most `(1/2)^n` -/
private lemma opn_tail_le (n : ℕ) : opnTail n ≤ (1 / 2 : ℝ) ^ n := by
  unfold opnTail
  have hb : Summable (fun i : ℕ => (1 / 2 : ℝ) ^ (n + 1) * (1 / 2 : ℝ) ^ i) :=
    summable_geometric_two.mul_left _
  calc ∑' (i : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (n + 2 + i) - 1)
      ≤ ∑' (i : ℕ), (1 / 2 : ℝ) ^ (n + 1) * (1 / 2 : ℝ) ^ i := by
        apply Summable.tsum_le_tsum _ (opn_summable_tail n) hb
        intro i
        calc (1 : ℝ) / ((2 : ℝ) ^ (n + 2 + i) - 1) ≤ 2 * (1 / 2 : ℝ) ^ (n + 2 + i) := opn_term_le _
          _ = (1 / 2 : ℝ) ^ (n + 1) * (1 / 2 : ℝ) ^ i := by rw [pow_add, pow_succ]; ring
    _ = (1 / 2 : ℝ) ^ (n + 1) * 2 := by rw [tsum_mul_left, tsum_geometric_two]
    _ = (1 / 2 : ℝ) ^ n := by rw [pow_succ]; ring

theorem variant_cce9b284__h7 : ∀ (x : ℝ) (r : ℕ → ℝ),
  (0 : ℝ) ≤ x →
    x ≤ (1 : ℝ) →
      r (0 : ℕ) = x →
        (∀ (k : ℕ),
            r (k + (1 : ℕ)) =
              if (1 : ℕ) ≤ k ∧ (1 : ℝ) / ((2 : ℝ) ^ k - (1 : ℝ)) ≤ r k then r k - (1 : ℝ) / ((2 : ℝ) ^ k - (1 : ℝ))
              else r k) →
          (∀ (n : ℕ),
              ¬(r (n + (1 : ℕ)) < (1 : ℝ) / ((2 : ℝ) ^ (n + (1 : ℕ)) - (1 : ℝ)) ∧
                  ∑' (i : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (n + (2 : ℕ) + i) - (1 : ℝ)) < r (n + (1 : ℕ)))) →
            ∑' (a : (↑{a : ℕ | (1 : ℕ) ≤ a ∧ (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) ≤ r a} : Type)),
                (1 : ℝ) / ((2 : ℝ) ^ (↑a : ℕ) - (1 : ℝ)) =
              x := by
  intro x r hx0 hx1 hr0 hr hns
  -- the no-stall hypothesis in terms of the tail
  have hns' : ∀ n : ℕ, r (n + 1) < (1 : ℝ) / ((2 : ℝ) ^ (n + 1) - 1) → r (n + 1) ≤ opnTail n := by
    intro n hlt
    by_contra h
    exact hns n ⟨hlt, lt_of_not_ge h⟩
  -- the remainder never goes negative
  have hnn : ∀ k, 0 ≤ r k := by
    intro k
    induction k with
    | zero => rw [hr0]; exact hx0
    | succ k ih =>
      rw [hr k]
      split_ifs with h
      · linarith [h.2]
      · exact ih
  -- the remainder after step n + 1 is at most the tail after n
  have hbound : ∀ n, r (n + 1) ≤ (1 : ℝ) / ((2 : ℝ) ^ (n + 1) - 1) + opnTail n := by
    intro n
    induction n with
    | zero =>
      rw [hr 0]
      simp only [show ¬ ((1 : ℕ) ≤ 0 ∧ (1 : ℝ) / ((2 : ℝ) ^ 0 - 1) ≤ r 0) from fun h => by omega, if_false]
      rw [hr0]
      have := opn_tail_nonneg 0
      norm_num
      linarith
    | succ n ih =>
      rw [opn_tail_succ n] at ih
      rw [hr (n + 1)]
      split_ifs with h
      · linarith
      · have hlt : r (n + 1) < (1 : ℝ) / ((2 : ℝ) ^ (n + 1) - 1) := by
          by_contra h'
          exact h ⟨by omega, le_of_not_gt h'⟩
        have := hns' n hlt
        rw [opn_tail_succ n] at this
        linarith
  -- hence the remainder tends to zero
  have hr_lim : Filter.Tendsto r Filter.atTop (nhds 0) := by
    rw [← Filter.tendsto_add_atTop_iff_nat 1]
    apply squeeze_zero (fun n => hnn (n + 1)) (fun n => ?_)
      ((tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num)).const_mul 2 |>.trans_eq (by simp))
    calc r (n + 1) ≤ (1 : ℝ) / ((2 : ℝ) ^ (n + 1) - 1) + opnTail n := hbound n
      _ ≤ 2 * (1 / 2 : ℝ) ^ (n + 1) + (1 / 2 : ℝ) ^ n := add_le_add (opn_term_le _) (opn_tail_le n)
      _ = 2 * (1 / 2 : ℝ) ^ n := by rw [pow_succ]; ring
  -- the chosen terms as a function on ℕ
  set f : ℕ → ℝ := fun a => if (1 : ℕ) ≤ a ∧ (1 : ℝ) / ((2 : ℝ) ^ a - 1) ≤ r a
    then (1 : ℝ) / ((2 : ℝ) ^ a - 1) else 0 with hf_def
  have hf_nonneg : ∀ a, 0 ≤ f a := by
    intro a
    simp only [hf_def]
    split_ifs
    · exact opn_term_nonneg a
    · exact le_rfl
  have hf_step : ∀ a, f a = r a - r (a + 1) := by
    intro a
    rw [hr a]
    simp only [hf_def]
    split_ifs <;> ring
  have hpartial : ∀ N, ∑ a ∈ Finset.range N, f a = x - r N := by
    intro N
    induction N with
    | zero => simp [hr0]
    | succ N ih => rw [Finset.sum_range_succ, ih, hf_step N]; ring
  have hhas : HasSum f x := by
    rw [hasSum_iff_tendsto_nat_of_nonneg hf_nonneg]
    simp only [hpartial]
    simpa using tendsto_const_nhds.sub hr_lim
  -- the subtype sum is the sum of the indicator, which is f
  have hind : ({a : ℕ | (1 : ℕ) ≤ a ∧ (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) ≤ r a} : Set ℕ).indicator
      (fun a : ℕ => (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ))) = f := by
    funext a
    simp only [Set.indicator_apply, Set.mem_setOf_eq, hf_def]
  calc ∑' (a : (↑{a : ℕ | (1 : ℕ) ≤ a ∧ (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) ≤ r a} : Type)),
          (1 : ℝ) / ((2 : ℝ) ^ (↑a : ℕ) - (1 : ℝ))
      = ∑' (a : ℕ), ({a : ℕ | (1 : ℕ) ≤ a ∧ (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) ≤ r a} : Set ℕ).indicator
          (fun a : ℕ => (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ))) a :=
        tsum_subtype ({a : ℕ | (1 : ℕ) ≤ a ∧ (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) ≤ r a} : Set ℕ)
          (fun a : ℕ => (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)))
    _ = x := by rw [hind]; exact hhas.tsum_eq
