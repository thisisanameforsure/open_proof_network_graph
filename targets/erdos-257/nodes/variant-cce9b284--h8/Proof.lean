import Mathlib
import Nodes.«variant-cce9b284--h8».Context

/-! Hole `h_finite_not_dyadic` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

private lemma opn_mersenne_odd (a : ℕ) (ha : 1 ≤ a) : Odd ((2 : ℕ) ^ a - 1) :=
  Nat.Even.sub_odd Nat.one_le_two_pow (Nat.even_pow.mpr ⟨even_two, by omega⟩) odd_one

private lemma opn_prod_odd (s : Finset ℕ) (hs : ∀ a ∈ s, 1 ≤ a) :
    Odd (∏ a ∈ s, ((2 : ℕ) ^ a - 1)) :=
  Finset.prod_induction _ Odd (fun _ _ => Odd.mul) odd_one (fun a ha => opn_mersenne_odd a (hs a ha))

private lemma opn_cast_mersenne (a : ℕ) : (((2 : ℕ) ^ a - 1 : ℕ) : ℝ) = (2 : ℝ) ^ a - 1 := by
  push_cast [Nat.one_le_two_pow]
  ring

theorem variant_cce9b284__h8 : ∀ (A : Set ℕ),
  A.Finite →
    (∀ a ∈ A, (1 : ℕ) ≤ a) →
      ∑' (n : (↑A : Type)), (1 : ℝ) / ((2 : ℝ) ^ (↑n : ℕ) - (1 : ℝ)) ≠ (1 : ℝ) / (2 : ℝ) ^ (20 : ℕ) := by
  intro A hA h1 heq
  set s := hA.toFinset with hs_def
  have hmem : ∀ a, a ∈ s ↔ a ∈ A := fun a => hA.mem_toFinset
  -- the tsum over the finite set is a finite sum
  have hsum : ∑' (n : (↑A : Type)), (1 : ℝ) / ((2 : ℝ) ^ (↑n : ℕ) - (1 : ℝ))
      = ∑ a ∈ s, (1 : ℝ) / ((2 : ℝ) ^ a - 1) := by
    rw [tsum_subtype A (fun a => (1 : ℝ) / ((2 : ℝ) ^ a - 1))]
    rw [tsum_eq_sum (s := s) (fun b hb => Set.indicator_of_notMem ((hmem b).not.mp hb) _)]
    exact Finset.sum_congr rfl (fun a ha => Set.indicator_of_mem ((hmem a).mp ha) _)
  rw [hsum] at heq
  -- the common denominator D, odd
  set D : ℕ := ∏ a ∈ s, ((2 : ℕ) ^ a - 1) with hD
  have hDodd : Odd D := opn_prod_odd s (fun a ha => h1 a ((hmem a).mp ha))
  have hdvd : ∀ a ∈ s, ((2 : ℕ) ^ a - 1) ∣ D := fun a ha => Finset.dvd_prod_of_mem _ ha
  have hne : ∀ a ∈ s, (((2 : ℕ) ^ a - 1 : ℕ) : ℝ) ≠ 0 := by
    intro a ha
    rw [opn_cast_mersenne]
    have h2 : (1 : ℝ) < (2 : ℝ) ^ a := one_lt_pow₀ (by norm_num) (by have := h1 a ((hmem a).mp ha); omega)
    linarith
  -- D times the sum is the natural number N
  set N : ℕ := ∑ a ∈ s, D / ((2 : ℕ) ^ a - 1) with hN
  have hDN : (D : ℝ) * ∑ a ∈ s, (1 : ℝ) / ((2 : ℝ) ^ a - 1) = (N : ℝ) := by
    rw [hN, Nat.cast_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun a ha => ?_)
    rw [Nat.cast_div (hdvd a ha) (hne a ha), opn_cast_mersenne]
    ring
  rw [heq] at hDN
  -- so D = 2^20 * N as naturals, which is even
  have hnat : D = 2 ^ 20 * N := by
    have h : (D : ℝ) = 2 ^ 20 * (N : ℝ) := by
      field_simp at hDN
      linarith
    exact_mod_cast h
  have heven : Even D := ⟨2 ^ 19 * N, by rw [hnat]; ring⟩
  exact (Nat.not_even_iff_odd.mpr hDodd) heven
