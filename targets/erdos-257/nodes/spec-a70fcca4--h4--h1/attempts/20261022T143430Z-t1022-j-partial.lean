import Mathlib
import Nodes.«spec-a70fcca4--h4--h1».Context

/-! Hole `hgap` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem spec_a70fcca4__h4__h1 : ∀ (r : ℕ → ℝ),
  r (0 : ℕ) = (1 / 2 : ℝ) →
    (∀ (m : ℕ),
        r (m + (1 : ℕ)) =
          if (1 : ℝ) / ((2 : ℝ) ^ m - (1 : ℝ)) ≤ r m then r m - (1 : ℝ) / ((2 : ℝ) ^ m - (1 : ℝ)) else r m) →
      ∀ (m : ℕ),
        r m < (1 : ℝ) / ((2 : ℝ) ^ m - (1 : ℝ)) → r m ≤ (1 : ℝ) / (2 : ℝ) ^ m + (1 : ℝ) / ((3 : ℝ) * (4 : ℝ) ^ m) := by
  -- approach: a skipped step m whose remainder exceeds the bound forces the walk to take every n in (m, 3m+2], because those terms sum to at most 2^-m + 4^-m/3; so the bound follows from a run statement whose window is the widest that works (with (m, 3m+3] the bound would force a skip instead)
  -- licence: CC-BY-4.0
  -- label: after a skipped m >= 1, another skip within (m, 3m+2]
  -- claim: $m \ge 1 \ \wedge\ r_m < \frac{1}{2^m-1} \ \Longrightarrow\ \exists n,\ m < n \le 3m+2 \ \wedge\ r_n < \frac{1}{2^n-1}$
  -- Here r is the greedy remainder of 1/2: r_0 = 1/2, r_(m+1) = r_m - 1/(2^m-1) if that term
  -- fits under r_m, else r_m.
  -- In words: the set the walk chooses never contains the whole block m+1, ..., 3m+2 right after
  -- an element m >= 1 it skipped. This is weaker than the hole of graph PR #865 (window (m, 2m],
  -- m >= 2) and essentially equivalent to this node: conversely, the node's bound at a skipped m
  -- forces a skip within (m, 3m+3], since the terms over (m, 3m+3] sum to more than
  -- 2^-m + 4^-m/3 (both inequalities checked exactly for m <= 120, margins 3/28 and 1/56 times 8^-m).
  have hrun : ∀ r : ℕ → ℝ, r 0 = 1 / 2 →
      (∀ m, r (m + 1) = if (1 : ℝ) / (2 ^ m - 1) ≤ r m then r m - 1 / (2 ^ m - 1) else r m) →
      ∀ m : ℕ, 1 ≤ m → r m < 1 / (2 ^ m - 1) →
        ∃ n : ℕ, m < n ∧ n ≤ 3 * m + 2 ∧ r n < 1 / (2 ^ n - 1) := sorry
  -- 1/(x-1) <= 1/x + 1/x^2 + (4/3)/x^3 for x >= 4.
  have hup : ∀ x : ℝ, 4 ≤ x → 1 / (x - 1) ≤ 1 / x + (1 / x) ^ 2 + 4 / 3 * (1 / x) ^ 3 := by
    intro x hx
    have hx0 : 0 < x := by linarith
    have hx1 : 0 < x - 1 := by linarith
    rw [div_le_iff₀ hx1]
    have h : (1 / x + (1 / x) ^ 2 + 4 / 3 * (1 / x) ^ 3) * (x - 1)
        = 1 + (1 / x) ^ 3 * (x / 3 - 4 / 3) := by
      field_simp
      ring
    rw [h]
    have : 0 ≤ (1 / x) ^ 3 * (x / 3 - 4 / 3) := by
      apply mul_nonneg (by positivity)
      linarith
    linarith
  -- The block (m, 3m+2] of terms sums to at most 2^-m + 4^-m/3.
  have hblock : ∀ m : ℕ, 1 ≤ m →
      ∑ i ∈ Finset.range (2 * m + 2), (1 : ℝ) / (2 ^ (m + 1 + i) - 1)
        ≤ 1 / 2 ^ m + 1 / (3 * 4 ^ m) := by
    intro m hm
    set a : ℝ := (1 / 2) ^ m with ha
    have ha0 : 0 < a := by positivity
    have ha1 : a ≤ 1 / 2 := by
      rw [ha]
      calc ((1 : ℝ) / 2) ^ m ≤ (1 / 2) ^ 1 := pow_le_pow_of_le_one (by norm_num) (by norm_num) hm
        _ = 1 / 2 := by norm_num
    have hterm : ∀ i ∈ Finset.range (2 * m + 2), (1 : ℝ) / (2 ^ (m + 1 + i) - 1)
        ≤ a * (1 / 2) * (1 / 2) ^ i + a ^ 2 * (1 / 4) * (1 / 4) ^ i
          + 4 / 3 * (a ^ 3 * (1 / 8) * (1 / 8) ^ i) := by
      intro i _
      have h4 : (4 : ℝ) ≤ 2 ^ (m + 1 + i) := by
        calc (4 : ℝ) = 2 ^ 2 := by norm_num
          _ ≤ 2 ^ (m + 1 + i) := pow_le_pow_right₀ (by norm_num) (by omega)
      refine (hup _ h4).trans (le_of_eq ?_)
      have h4i : (4 : ℝ) ^ i = 2 ^ (i * 2) := by rw [mul_comm, pow_mul]; norm_num
      have h8i : (8 : ℝ) ^ i = 2 ^ (i * 3) := by rw [mul_comm, pow_mul]; norm_num
      simp only [ha, one_div, inv_pow, ← pow_mul, pow_add]
      field_simp
      rw [h4i, h8i]
      ring
    refine (Finset.sum_le_sum hterm).trans ?_
    rw [Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum,
      ← Finset.mul_sum, ← Finset.mul_sum, geom_sum_eq (by norm_num), geom_sum_eq (by norm_num),
      geom_sum_eq (by norm_num)]
    have e2 : ((1 : ℝ) / 2) ^ (2 * m + 2) = a ^ 2 / 4 := by
      rw [ha, pow_add, pow_mul, ← pow_mul, mul_comm 2 m, pow_mul]; norm_num; ring
    have e4 : ((1 : ℝ) / 4) ^ (2 * m + 2) = a ^ 4 / 16 := by
      rw [ha, pow_add, pow_mul]
      rw [show ((1 : ℝ) / 4) ^ 2 = (1 / 2) ^ 4 by norm_num, ← pow_mul, mul_comm 4 m, pow_mul]
      norm_num; ring
    have e8 : ((1 : ℝ) / 8) ^ (2 * m + 2) = a ^ 6 / 64 := by
      rw [ha, pow_add, pow_mul]
      rw [show ((1 : ℝ) / 8) ^ 2 = (1 / 2) ^ 6 by norm_num, ← pow_mul, mul_comm 6 m, pow_mul]
      norm_num; ring
    rw [e2, e4, e8]
    have hb1 : (1 : ℝ) / 2 ^ m = a := by rw [ha, one_div_pow]
    have hb2 : (1 : ℝ) / (3 * 4 ^ m) = a ^ 2 / 3 := by
      rw [ha]; field_simp; rw [← pow_mul, mul_comm m 2, pow_mul, ← mul_pow]; norm_num
    rw [hb1, hb2]
    have key : a * (1 / 2) * ((a ^ 2 / 4 - 1) / (1 / 2 - 1))
        + a ^ 2 * (1 / 4) * ((a ^ 4 / 16 - 1) / (1 / 4 - 1))
        + 4 / 3 * (a ^ 3 * (1 / 8) * ((a ^ 6 / 64 - 1) / (1 / 8 - 1)))
        = a + a ^ 2 / 3 - 5 / 84 * a ^ 3 - a ^ 6 / 48 - a ^ 9 / 336 := by
      field_simp
      ring
    rw [key]
    nlinarith [pow_pos ha0 3, pow_pos ha0 6, pow_pos ha0 9]
  intro r h0 hrs m hlt
  rcases Nat.lt_or_ge m 1 with hm | hm
  · interval_cases m
    rw [h0] at hlt; norm_num at hlt
  · by_contra hc
    push_neg at hc
    obtain ⟨n, hmn, hn3, hnlt⟩ := hrun r h0 hrs m hm hlt
    have hpart : ∀ j, j < 2 * m + 2 →
        ∑ i ∈ Finset.range (j + 1), (1 : ℝ) / (2 ^ (m + 1 + i) - 1) < r m := by
      intro j hj
      refine lt_of_le_of_lt ?_ ((hblock m hm).trans_lt hc)
      refine Finset.sum_le_sum_of_subset_of_nonneg
        (fun x hx => by simp only [Finset.mem_range] at hx ⊢; omega) ?_
      intro i _ _
      have : (1 : ℝ) ≤ 2 ^ (m + 1 + i) := one_le_pow₀ (by norm_num)
      exact div_nonneg zero_le_one (by linarith)
    have hwalk : ∀ j, j < 2 * m + 2 →
        r (m + 1 + j) = r m - ∑ i ∈ Finset.range j, (1 : ℝ) / (2 ^ (m + 1 + i) - 1)
        ∧ (1 : ℝ) / (2 ^ (m + 1 + j) - 1) ≤ r (m + 1 + j) := by
      intro j
      induction j with
      | zero =>
        intro hj
        have hr1 : r (m + 1) = r m := by
          rw [hrs m, if_neg (not_le.mpr hlt)]
        have := hpart 0 hj
        simp only [zero_add, Finset.sum_range_one, add_zero, Finset.range_zero, Finset.sum_empty,
          sub_zero] at this ⊢
        exact ⟨hr1, by rw [hr1]; exact this.le⟩
      | succ j ih =>
        intro hj
        obtain ⟨hrj, hle⟩ := ih (by omega)
        have hstep : r (m + 1 + (j + 1))
            = r m - ∑ i ∈ Finset.range (j + 1), (1 : ℝ) / (2 ^ (m + 1 + i) - 1) := by
          rw [show m + 1 + (j + 1) = (m + 1 + j) + 1 by omega, hrs (m + 1 + j), if_pos hle, hrj,
            Finset.sum_range_succ]
          ring
        refine ⟨hstep, ?_⟩
        rw [hstep]
        have := hpart (j + 1) hj
        rw [Finset.sum_range_succ] at this
        linarith
    obtain ⟨_, hle⟩ := hwalk (n - m - 1) (by omega)
    rw [show m + 1 + (n - m - 1) = n by omega] at hle
    linarith

