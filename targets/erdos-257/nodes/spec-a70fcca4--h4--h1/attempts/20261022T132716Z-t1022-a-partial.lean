theorem spec_a70fcca4__h4__h1 : ∀ (r : ℕ → ℝ),
  r (0 : ℕ) = (1 / 2 : ℝ) →
    (∀ (m : ℕ),
        r (m + (1 : ℕ)) =
          if (1 : ℝ) / ((2 : ℝ) ^ m - (1 : ℝ)) ≤ r m then r m - (1 : ℝ) / ((2 : ℝ) ^ m - (1 : ℝ)) else r m) →
      ∀ (m : ℕ),
        r m < (1 : ℝ) / ((2 : ℝ) ^ m - (1 : ℝ)) → r m ≤ (1 : ℝ) / (2 : ℝ) ^ m + (1 : ℝ) / ((3 : ℝ) * (4 : ℝ) ^ m) := by
  -- approach: a skipped step m with r_m > 2^-m forces the walk to take every n in (m, 2m], because those terms sum to less than 2^-m; so the explicit bound follows from a statement about runs of the chosen set
  -- licence: CC-BY-4.0
  -- label: after a skipped m >= 2, another skip within (m, 2m]
  -- claim: $m \ge 2,\ r_m < \frac{1}{2^m-1} \Rightarrow \exists n,\ m < n \le 2m,\ r_n < \frac{1}{2^n-1}$, for the greedy remainder $r$ of $\frac12$
  -- In words: the set A the walk chooses never contains the whole block m+1, ..., 2m right after
  -- an element m >= 2 it skipped. A purely combinatorial statement about runs of A. It is
  -- stronger than the parent (it also excludes 2^-m < r_m <= 2^-m + 4^-m/3 at a skipped m), and
  -- holds numerically to depth 5000 (longest run of consecutive chosen elements 13; the lead
  -- reports 20 at depth 10^6, against the m needed at step m).
  have hrun : ∀ r : ℕ → ℝ, r 0 = 1 / 2 →
      (∀ m, r (m + 1) = if (1 : ℝ) / (2 ^ m - 1) ≤ r m then r m - 1 / (2 ^ m - 1) else r m) →
      ∀ m : ℕ, 2 ≤ m → r m < 1 / (2 ^ m - 1) →
        ∃ n : ℕ, m < n ∧ n ≤ 2 * m ∧ r n < 1 / (2 ^ n - 1) := sorry
  -- The block (m, 2m] of terms sums to less than 2^-m: 1/(2^k-1) <= 2^-k + 2*4^-k for k >= 1.
  have hup : ∀ x : ℝ, 2 ≤ x → 1 / (x - 1) ≤ (1 / 2) * (2 / x) + 2 * (1 / x) ^ 2 := by
    intro x hx
    rw [div_le_iff₀ (by linarith)]
    have hx0 : 0 < x := by linarith
    field_simp
    nlinarith
  have hblock : ∀ m : ℕ, 1 ≤ m →
      ∑ i ∈ Finset.range m, (1 : ℝ) / (2 ^ (m + 1 + i) - 1) < 1 / 2 ^ m := by
    intro m hm
    set a : ℝ := (1 / 2) ^ m with ha
    have ha0 : 0 < a := by positivity
    have hterm : ∀ i ∈ Finset.range m, (1 : ℝ) / (2 ^ (m + 1 + i) - 1)
        ≤ a * (1 / 2) * (1 / 2) ^ i + 2 * (a ^ 2 * (1 / 4) * (1 / 4) ^ i) := by
      intro i _
      have h2 : (2 : ℝ) ≤ 2 ^ (m + 1 + i) := by
        calc (2 : ℝ) = 2 ^ 1 := by norm_num
          _ ≤ 2 ^ (m + 1 + i) := pow_le_pow_right₀ (by norm_num) (by omega)
      refine (hup _ h2).trans (le_of_eq ?_)
      have h4i : (4 : ℝ) ^ i = 2 ^ (i * 2) := by rw [mul_comm, pow_mul]; norm_num
      simp only [ha, one_div, inv_pow, ← pow_mul, pow_add]
      field_simp
      rw [h4i]
      ring
    refine lt_of_le_of_lt (Finset.sum_le_sum hterm) ?_
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum,
      geom_sum_eq (by norm_num), geom_sum_eq (by norm_num)]
    have h4 : ((1 : ℝ) / 4) ^ m = a ^ 2 := by
      rw [ha, ← pow_mul, mul_comm, pow_mul]; norm_num
    rw [h4, ← ha, show (1 : ℝ) / 2 ^ m = a by rw [ha, one_div_pow]]
    have key : a * (1 / 2) * ((a - 1) / (1 / 2 - 1)) + 2 * (a ^ 2 * (1 / 4) * ((a ^ 2 - 1) / (1 / 4 - 1)))
        = a - a ^ 2 / 3 - 2 / 3 * a ^ 4 := by
      field_simp
      ring
    rw [key]
    nlinarith [pow_pos ha0 4, pow_pos ha0 2]
  intro r h0 hrs m hlt
  rcases Nat.lt_or_ge m 2 with hm | hm
  · interval_cases m
    · rw [h0] at hlt; norm_num at hlt
    · rw [hrs 0, h0]; norm_num
  · by_contra hc
    push_neg at hc
    have hpos : (0 : ℝ) < 1 / (3 * 4 ^ m) := by positivity
    have hbig : 1 / 2 ^ m < r m := by linarith
    obtain ⟨n, hmn, hn2, hnlt⟩ := hrun r h0 hrs m hm hlt
    have hpart : ∀ j, j < m → ∑ i ∈ Finset.range (j + 1), (1 : ℝ) / (2 ^ (m + 1 + i) - 1) < r m := by
      intro j hj
      refine lt_of_le_of_lt ?_ ((hblock m (by omega)).trans hbig)
      refine Finset.sum_le_sum_of_subset_of_nonneg (fun x hx => by simp only [Finset.mem_range] at hx ⊢; omega) ?_
      intro i _ _
      have : (1 : ℝ) ≤ 2 ^ (m + 1 + i) := one_le_pow₀ (by norm_num)
      exact div_nonneg zero_le_one (by linarith)
    have hwalk : ∀ j, j < m → r (m + 1 + j) = r m - ∑ i ∈ Finset.range j, (1 : ℝ) / (2 ^ (m + 1 + i) - 1)
        ∧ (1 : ℝ) / (2 ^ (m + 1 + j) - 1) ≤ r (m + 1 + j) := by
      intro j
      induction j with
      | zero =>
        intro hj
        have hr1 : r (m + 1) = r m := by
          rw [hrs m, if_neg (not_le.mpr hlt)]
        have := hpart 0 hj
        simp only [zero_add, Finset.sum_range_one, add_zero, Finset.range_zero, Finset.sum_empty, sub_zero] at this ⊢
        exact ⟨hr1, by rw [hr1]; exact this.le⟩
      | succ j ih =>
        intro hj
        obtain ⟨hrj, hle⟩ := ih (by omega)
        have hstep : r (m + 1 + (j + 1)) = r m - ∑ i ∈ Finset.range (j + 1), (1 : ℝ) / (2 ^ (m + 1 + i) - 1) := by
          rw [show m + 1 + (j + 1) = (m + 1 + j) + 1 by omega, hrs (m + 1 + j), if_pos hle, hrj,
            Finset.sum_range_succ]
          ring
        refine ⟨hstep, ?_⟩
        rw [hstep]
        have := hpart (j + 1) hj
        rw [Finset.sum_range_succ] at this
        linarith
    obtain ⟨_, hle⟩ := hwalk (n - m - 1) (by omega)
    rw [show m + 1 + (n - m - 1) = n by omega] at hle
    linarith
