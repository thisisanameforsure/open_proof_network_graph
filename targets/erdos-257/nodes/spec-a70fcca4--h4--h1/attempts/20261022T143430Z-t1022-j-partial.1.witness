import Mathlib
-- hole: hrun

theorem witness : ∃ (r : ℕ → ℝ) (m : ℕ), r 0 = 1 / 2 ∧
    (∀ m, r (m + 1) = if (1 : ℝ) / (2 ^ m - 1) ≤ r m then r m - 1 / (2 ^ m - 1) else r m) ∧
    1 ≤ m ∧ r m < 1 / (2 ^ m - 1) :=
  ⟨fun m => Nat.rec (1 / 2 : ℝ)
      (fun k rk => if (1 : ℝ) / (2 ^ k - 1) ≤ rk then rk - 1 / (2 ^ k - 1) else rk) m,
    1, rfl, fun _ => rfl, le_refl 1, by
      show (if (1 : ℝ) / (2 ^ 0 - 1) ≤ (1 / 2 : ℝ) then (1 / 2 : ℝ) - 1 / (2 ^ 0 - 1) else 1 / 2)
        < 1 / (2 ^ 1 - 1)
      norm_num⟩
